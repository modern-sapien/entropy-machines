#!/bin/sh
# Arm, disarm, inspect, or hand-fire the unattended drainer.
#
#   scripts/drain on          # arm it — the next launchd fire does work
#   scripts/drain off         # disarm — fires still happen and exit immediately
#   scripts/drain status      # armed? last fire? last 429? what is eligible?
#   scripts/drain now         # run one fire in the foreground, right now
#
# WHY A FLAG FILE RATHER THAN launchctl load/unload.
#
# `launchctl unload` is a stateful operation on a plist that also has to survive
# reboots and login cycles, and getting it wrong leaves the job either
# permanently dead or permanently running with no obvious tell. A flag file is
# a boolean the runner reads at the top of every fire: `off` takes effect on the
# next fire with nothing to reload, `on` needs no privileges, and `status` can
# answer honestly by reading one path. The launchd job stays loaded either way.
#
# The owner asked for exactly this on UNATTENDED-OPS (2026-08-09): "Anyway I can
# switch on the probe or this auto scheduler myself?"
set -e

root=$(cd "$(dirname "$0")/.." && pwd)
state="${JANUS_DRAIN_HOME:-$HOME/.janus-unattended}"
flag="$state/armed"
log="$state/last-run.json"

mkdir -p "$state"

# The last 429 this machine saw, from Claude Code's own session logs. There is
# no API for the rate-limit window (checked 2026-08-09: stats-cache.json has no
# window field and is months stale; /usage is not exposed to the CLI), but a 429
# IS recorded, with a timestamp. That is enough to skip a fire that would only
# hit the wall again.
last_429() {
  python3 - <<'PY' 2>/dev/null || true
import glob, json, os
newest = None
for f in glob.glob(os.path.expanduser("~/.claude/projects/**/*.jsonl"), recursive=True):
    try:
        if os.path.getmtime(f) < __import__("time").time() - 6 * 3600:
            continue
        for line in open(f, errors="ignore"):
            if '"error":"rate_limit"' in line:
                try:
                    ts = json.loads(line).get("timestamp")
                except Exception:
                    continue
                if ts and (newest is None or ts > newest):
                    newest = ts
    except OSError:
        continue
print(newest or "")
PY
}

case "${1:-status}" in
  on)
    date -u +%Y-%m-%dT%H:%M:%SZ > "$flag"
    echo "drain: ARMED (since $(cat "$flag"))"
    echo "  the next launchd fire will pick up work; 'scripts/drain off' stops it."
    ;;

  off)
    rm -f "$flag"
    echo "drain: DISARMED"
    echo "  fires still happen on schedule and exit immediately. Nothing to unload."
    ;;

  status)
    # Two independent switches, and confusing them is the likely support
    # question: the job can be loaded but disarmed (fires, does nothing), or
    # armed but never installed (nothing ever fires). Report both.
    if launchctl list 2>/dev/null | grep -q com.janus.drain; then
      echo "scheduled:  yes (hourly, at :07)"
    else
      echo "scheduled:  no — run 'scripts/drain install'"
    fi
    if [ -f "$state/once.pid" ] && kill -0 "$(cat "$state/once.pid")" 2>/dev/null; then
      echo "one-shot:   $(cat "$state/once.at" 2>/dev/null) (pid $(cat "$state/once.pid"))"
    else
      echo "one-shot:   none — 'scripts/drain at HH:MM' to set one"
    fi
    if [ -f "$flag" ]; then
      echo "armed:      yes (since $(cat "$flag"))"
    else
      echo "armed:      no — run 'scripts/drain on'"
    fi
    if [ -f "$log" ]; then
      # Heredoc + env var rather than `python3 -c '...'`: the inline form needs
      # quotes nested three deep (sh, python, f-string) and the first version
      # of this line printed its own source back four times.
      DRAIN_LOG="$log" python3 <<'PY'
import json, os
try:
    d = json.load(open(os.environ["DRAIN_LOG"]))
    print(f'last fire:  {d.get("finishedAt", "?")} — {d.get("outcome", "?")}'
          f' ({d.get("detail", "")})')
except Exception as exc:
    print(f"last fire:  unreadable ({exc})")
PY
    else
      echo "last fire:  never"
    fi
    l=$(last_429)
    if [ -n "$l" ]; then
      echo "last 429:   $l"
    else
      echo "last 429:   none in the last 6h"
    fi
    # What it would actually take, so `status` answers "is there anything to do"
    # and not merely "is the switch up".
    if [ -x "$root/scripts/tracker" ]; then
      n=$("$root/scripts/tracker" ready --autonomous 2>/dev/null | grep -c '^  ' || true)
      echo "eligible:   ${n:-0} issue(s) an unattended run may take"
    fi
    ;;

  now)
    echo "drain: firing once in the foreground (ignores the armed flag)"
    exec "$root/scripts/drain-run.sh" --foreground
    ;;

  at)
    # One fire at a time you name. This is the answer to "I can just read the
    # reset out of /usage" — you can, and a rolling window means that reading
    # is only true for today, which is exactly what a ONE-SHOT is for. The
    # hourly probe chases a moving window; this hits a boundary you already
    # know. They do not conflict and neither needs the other.
    when="$2"
    case "$when" in
      [0-9][0-9]:[0-9][0-9]) ;;
      *) echo "usage: scripts/drain at HH:MM   (24-hour, local)" >&2; exit 2 ;;
    esac
    hh=${when%:*}; mm=${when#*:}
    # Strip a leading zero before arithmetic — 08 and 09 are invalid octal and
    # would make plutil reject the plist with a baffling error.
    hh=$((10#$hh)); mm=$((10#$mm))
    if [ "$hh" -gt 23 ] || [ "$mm" -gt 59 ]; then
      echo "scripts/drain at: $when is not a real time" >&2; exit 2
    fi
    # A DETACHED SLEEP, not a LaunchAgent. This repo lives under ~/Desktop,
    # which macOS TCC protects: a launchd agent running /bin/sh is denied
    # ("Operation not permitted") before the script's first line, verified
    # 2026-08-09 with a probe that could read /tmp and not ~/Desktop. A process
    # spawned from your terminal inherits the terminal's TCC grant and reads
    # the repo fine, so this is the form that works with no permission changes.
    #
    # The trade: it does not survive a reboot, and if the Mac sleeps through
    # the target the timer resumes on wake and fires late rather than on time.
    # For "resume at the reset I just read out of /usage", that is the right
    # shape anyway — you are naming a moment tonight, not a standing schedule.
    now_s=$(date +%s)
    tgt_s=$(date -j -f "%Y-%m-%d %H:%M:%S" "$(date +%Y-%m-%d) $(printf '%02d:%02d:00' "$hh" "$mm")" +%s 2>/dev/null)
    [ -z "$tgt_s" ] && { echo "scripts/drain at: could not parse $when" >&2; exit 2; }
    if [ "$tgt_s" -le "$now_s" ]; then
      tgt_s=$((tgt_s + 86400))   # already past today → mean tomorrow
    fi
    wait_s=$((tgt_s - now_s))
    # Replace any pending one-shot rather than stacking two fires.
    if [ -f "$state/once.pid" ] && kill -0 "$(cat "$state/once.pid")" 2>/dev/null; then
      kill "$(cat "$state/once.pid")" 2>/dev/null || true
    fi
    nohup sh -c "sleep $wait_s; exec '$root/scripts/drain-run.sh' --foreground" \
      > "$state/once.log" 2>&1 &
    echo $! > "$state/once.pid"
    printf '%s\n' "$(date -r "$tgt_s" '+%Y-%m-%d %H:%M')" > "$state/once.at"
    echo "drain: one fire at $(cat "$state/once.at") — in $((wait_s / 60)) min (pid $(cat "$state/once.pid"))"
    echo "  runs whether or not 'drain on' is set; log: $state/once.log"
    echo "  cancel with: scripts/drain cancel"
    echo "  NOTE: a detached timer, so it does not survive a reboot."
    ;;

  cancel)
    if [ -f "$state/once.pid" ] && kill -0 "$(cat "$state/once.pid")" 2>/dev/null; then
      kill "$(cat "$state/once.pid")" 2>/dev/null || true
      echo "drain: cancelled the one-shot that was set for $(cat "$state/once.at" 2>/dev/null)"
    else
      echo "drain: no one-shot pending"
    fi
    rm -f "$state/once.pid" "$state/once.at"
    launchctl bootout "gui/$(id -u)/com.janus.drain.once" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/com.janus.drain.once.plist"
    ;;

  install)
    # TCC refuses a LaunchAgent access to ~/Desktop, ~/Documents and
    # ~/Downloads. Installing a job that is denied before its first line is
    # worse than installing none, because `launchctl list` shows it loaded and
    # everything looks armed. Check the actual repo location and say so.
    case "$root" in
      "$HOME"/Desktop/*|"$HOME"/Documents/*|"$HOME"/Downloads/*)
        echo "scripts/drain install: refusing — this repo is in a TCC-protected folder." >&2
        echo "  $root" >&2
        echo "  A LaunchAgent is denied here before it runs a line (verified:" >&2
        echo "  launchd can read /tmp and not ~/Desktop). Three ways forward:" >&2
        echo "    1. scripts/drain at HH:MM   — a detached timer, works today," >&2
        echo "                                  no permissions, no reboot survival" >&2
        echo "    2. move the repo out of ~/Desktop (e.g. ~/code/janus)" >&2
        echo "    3. System Settings → Privacy & Security → Full Disk Access," >&2
        echo "       add /bin/sh — broad, since it grants every shell script" >&2
        echo "  Override once you have done 2 or 3: JANUS_DRAIN_FORCE=1" >&2
        [ -z "$JANUS_DRAIN_FORCE" ] && exit 3
        echo "  JANUS_DRAIN_FORCE set — installing anyway." >&2
        ;;
    esac
    plist="$HOME/Library/LaunchAgents/com.janus.drain.plist"
    mkdir -p "$HOME/Library/LaunchAgents"
    sed "s|__RUNNER__|$root/scripts/drain-run.sh|g; s|__STATE__|$state|g" \
      "$root/scripts/com.janus.drain.plist.in" > "$plist"
    launchctl bootout "gui/$(id -u)/com.janus.drain" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "drain: launchd job installed and loaded (hourly probe)"
    echo "  it is INERT until you run 'scripts/drain on'."
    echo "  to remove: launchctl bootout gui/$(id -u)/com.janus.drain && rm $plist"
    echo
    echo "  One step left, and it needs sudo so it is yours to run — without it"
    echo "  the job cannot fire while the Mac is asleep:"
    echo "    sudo pmset repeat wakeorpoweron MTWRFSU 02:00:00"
    ;;

  *)
    echo "usage: scripts/drain [status|now|at HH:MM|cancel|on|off|install]" >&2
    echo "  at HH:MM   one fire at a time you name (read it out of /usage)" >&2
    echo "  on/off     the hourly probe, for windows you have not read" >&2
    exit 2
    ;;
esac
