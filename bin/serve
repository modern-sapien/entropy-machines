#!/bin/sh
# The factory lights. A local web server, not a CLI:
#
#   bin/serve [port]      # default 8787
#
#   GET  /                       dashboard — ready issues, in-flight claims,
#                                 per-doc answered/unanswered counts. Built
#                                 only from what bin/tracker and lib/notes.py
#                                 already know; no new state.
#   GET  /<doc>.html             a doc from the configured docs directory,
#                                 with the Downloads-folder save always
#                                 defeated (see SAVE_PATCH below).
#   GET  /__docversion?file=<f>  {"reviews": "<hash>"} — polled by the doc's
#                                 own baked-in reload watcher. Changes when
#                                 the doc changes for a reason OTHER than the
#                                 reader's own answer being written back — see
#                                 docs/SERVE.md.
#   POST /__save?file=<f>        body is {data-resp: answer}; merged back
#                                 into <f> ON DISK, atomically. On success,
#                                 docstate.on_save() snapshots the version
#                                 and flips the doc's status to in-review.
#   GET  /__docstatus?file=<f>   {"status":"open","version":3,...} — the
#                                 doc's current status from manifest.json.
#   POST /__docstatus            body is {"file":"<f>","status":"<s>"};
#                                 calls docstate.set_status() to move the
#                                 doc to the given status.
#   /api/*                       REST endpoints for the React SPA (ui/),
#                                 reading/writing .entropy-machines/
#                                 entropy-machines.db — see lib/api.py's own
#                                 docstring for the endpoint table.
#
# See docs/SERVE.md for the full contract, the docversion hash's exact
# semantics, and the dashboard's data sources.
set -e

usage() {
  cat >&2 <<'EOF'
usage: bin/serve [port]
EOF
  exit 2
}

case "$1" in
  -h|--help) usage ;;
esac

. "$(dirname "$0")/../lib/roots.sh"
ENTROPY_MACHINES_HOME=$(entropy_machines_home "$0")
entropy_machines_require_root serve

CONFIG_PY="$ENTROPY_MACHINES_HOME/lib/config.py"
NOTES_PY="$ENTROPY_MACHINES_HOME/lib/notes.py"
TRACKER="$ENTROPY_MACHINES_HOME/bin/tracker"

# docs.dir has no entry in lib/config.py's DEFAULTS (that file is shared
# infrastructure, not this bullet's to extend) — so a project that has not
# set it fails config.py's "no such key" lookup, and that failure IS the
# default path, not an error to surface.
# tracker config — read here so the Python half can render TRACKER.html
# dynamically from live issues.json without re-reading config.json itself
# (docs/CONFIG.md rule 3).
tracker_backend=$(python3 "$CONFIG_PY" get tracker.backend 2>/dev/null) || tracker_backend="file"
tracker_file_path=$(python3 "$CONFIG_PY" get tracker.file.path 2>/dev/null) || tracker_file_path=".entropy-machines/issues.json"
project_name=$(python3 "$CONFIG_PY" get project.name 2>/dev/null) || project_name=""

docs_dir=$(python3 "$CONFIG_PY" get docs.dir 2>/dev/null) || docs_dir="entropy-machines-docs"
case "$docs_dir" in
  /*) docs_path="$docs_dir" ;;
  *) docs_path="$ENTROPY_MACHINES_ROOT/$docs_dir" ;;
esac
mkdir -p "$docs_path"

# THEME — config-driven, not CSS files. Themes are 5-color config objects
# embedded directly in templates and applied via style.setProperty. No theme
# CSS files, no docs.theme config key needed for basic serving.

# SPA — the React frontend's production build. When ui/dist/ exists, serve its
# static files and use index.html as the SPA fallback for client-side routes.
# Check two locations: sibling to bin/ ($ENTROPY_MACHINES_HOME/ui/dist/) and
# at the project root ($ENTROPY_MACHINES_ROOT/ui/dist/). If neither exists,
# SERVE_SPA_ROOT stays empty and the server falls through to legacy behavior.
SERVE_SPA_ROOT=""
if [ -f "$ENTROPY_MACHINES_HOME/ui/dist/index.html" ]; then
  SERVE_SPA_ROOT="$ENTROPY_MACHINES_HOME/ui/dist"
elif [ -f "$ENTROPY_MACHINES_ROOT/ui/dist/index.html" ]; then
  SERVE_SPA_ROOT="$ENTROPY_MACHINES_ROOT/ui/dist"
fi

SERVE_NO_OPEN=""
port=""
for _arg in "$@"; do
  case "$_arg" in
    --no-open) SERVE_NO_OPEN=1 ;;
    *) port="$_arg" ;;
  esac
done
port="${port:-8787}"
case "$port" in
  ''|*[!0-9]*)
    echo "serve: REFUSED — port must be a number, got '$port'." >&2
    usage
    ;;
esac

export ENTROPY_MACHINES_HOME ENTROPY_MACHINES_ROOT
export SERVE_DOCS_PATH="$docs_path"
export SERVE_DOCS_DIR="$docs_dir"
export SERVE_PORT="$port"
export SERVE_NO_OPEN="$SERVE_NO_OPEN"
export SERVE_TRACKER="$TRACKER"
export SERVE_NOTES_PY="$NOTES_PY"
export SERVE_TRACKER_BACKEND="$tracker_backend"
export SERVE_TRACKER_FILE_PATH="$tracker_file_path"
export SERVE_PROJECT_NAME="$project_name"
export SERVE_SPA_ROOT="$SERVE_SPA_ROOT"

exec python3 - <<'PY'
"""bin/serve's HTTP server, run via `python3 -` from the shell shim above.
Everything it needs — roots, docs dir, port — arrives as environment, already
resolved by bin/serve (docs/CONFIG.md rule 3: a backend never re-reads
config.json itself; this applies the same discipline to bin/serve's own
python half).
"""
from __future__ import annotations

import hashlib
import html
import json
import importlib
import importlib.util
import os
import re
import socket
import subprocess
import sys
import tempfile
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

ENTROPY_MACHINES_HOME = os.environ["ENTROPY_MACHINES_HOME"]
ENTROPY_MACHINES_ROOT = os.environ["ENTROPY_MACHINES_ROOT"]
DOCS_PATH = os.environ["SERVE_DOCS_PATH"]
DOCS_DIR = os.environ["SERVE_DOCS_DIR"]
PORT = int(os.environ["SERVE_PORT"])
TRACKER = os.environ["SERVE_TRACKER"]
NOTES_PY = os.environ["SERVE_NOTES_PY"]
TRACKER_BACKEND = os.environ.get("SERVE_TRACKER_BACKEND", "file")
TRACKER_FILE_PATH = os.environ.get("SERVE_TRACKER_FILE_PATH",
                                    ".entropy-machines/issues.json")
PROJECT_NAME = os.environ.get("SERVE_PROJECT_NAME", "")

# SPA — the React frontend's production build. When SPA_ROOT is set and the
# directory contains index.html, the server serves its static files at
# /assets/* and uses index.html as the SPA fallback for any route not
# matched by /api/*, /__doc*, /__save, TRACKER.html, legacy doc files, or
# /assets/*. When SPA_ROOT is empty, legacy behavior is unchanged.
SPA_ROOT = os.environ.get("SERVE_SPA_ROOT", "")
SPA_INDEX = os.path.join(SPA_ROOT, "index.html") if SPA_ROOT else ""
SPA_AVAILABLE = bool(SPA_ROOT and os.path.isfile(SPA_INDEX))

# MIME types for static assets served from ui/dist/assets/.
_MIME_TYPES = {
    ".js":    "application/javascript",
    ".mjs":   "application/javascript",
    ".css":   "text/css",
    ".html":  "text/html; charset=utf-8",
    ".json":  "application/json",
    ".svg":   "image/svg+xml",
    ".png":   "image/png",
    ".jpg":   "image/jpeg",
    ".jpeg":  "image/jpeg",
    ".gif":   "image/gif",
    ".ico":   "image/x-icon",
    ".woff":  "font/woff",
    ".woff2": "font/woff2",
    ".ttf":   "font/ttf",
    ".eot":   "application/vnd.ms-fontobject",
    ".map":   "application/json",
    ".txt":   "text/plain; charset=utf-8",
}

sys.path.insert(0, os.path.join(ENTROPY_MACHINES_HOME, "lib"))

# api — /api/* REST endpoints for the React SPA (ui/), reading/writing
# .entropy-machines/entropy-machines.db. Optional import, same reasoning as
# docstate below: an older checkout without lib/api.py or without a migrated
# db just gets a 404/503 on /api/* instead of a crash.
try:
    import api as api_module
except ImportError:
    api_module = None

# tracker_view — dynamic rendering of the tracker page from live issues.json.
# Optional: if missing the server falls through to the static TRACKER.html.
# The file is named tracker-view.py (with a hyphen), so a plain `import` cannot
# reach it; importlib loads it by path.
try:
    _tv_spec = importlib.util.spec_from_file_location(
        "tracker_view",
        os.path.join(ENTROPY_MACHINES_HOME, "lib", "tracker-view.py"))
    tracker_view = importlib.util.module_from_spec(_tv_spec)
    _tv_spec.loader.exec_module(tracker_view)
except Exception:  # noqa: BLE001 — any failure: fall back to static file
    tracker_view = None

# docstate lives in lib/ — add it to the path so we can import it.
# Optional: if docstate.py is not present the server works without it —
# POST /__save still merges answers, the /__docstatus endpoints 404, and
# no snapshot/status bookkeeping runs. This is the first-clone state before
# lib/docstate.py is committed.
try:
    import docstate
except ImportError:
    docstate = None

# ---------------------------------------------------------------------------
# DOCSTATE — init once; on_save() is called from POST /__save.
# init() is best-effort: if the manifest does not exist (first-run, no docs
# built yet) docstate functions silently no-op via on_save's "file not in
# manifest" guard, and the /__docstatus endpoints return 404.
# ---------------------------------------------------------------------------
if docstate is not None:
    try:
        docstate.init(DOCS_PATH)
    except Exception:  # noqa: BLE001
        pass

# THEME — config-driven. Themes are 5-color config objects embedded directly
# in templates and applied via style.setProperty. No CSS file reading needed.


# ---------------------------------------------------------------------------
# DYNAMIC TRACKER RENDERING — live from issues.json, no stale static file.
#
# Every GET /TRACKER.html reads the issue store directly and renders a fresh
# page using tracker_view's build_payload + TEMPLATE, so changes to issues
# show up immediately without needing to re-run `bin/tracker render`. The
# static TRACKER.html in the docs directory is still written by that command
# and remains the fallback for file:// access, but the served version is
# always live.
#
# Only the "file" backend is supported for live rendering — a "command"
# backend's store is opaque (see tracker-view.py's own docstring for why).
# When dynamic rendering is unavailable, the request falls through to the
# normal doc-serving path, which serves the static file if it exists.
# ---------------------------------------------------------------------------
def render_tracker_live():
    """Render TRACKER.html in memory from the live issues.json store.

    Returns the HTML string, or None if dynamic rendering is not available
    (wrong backend, missing module, etc.) — the caller falls through to
    the static file.
    """
    if tracker_view is None or TRACKER_BACKEND != "file":
        return None
    store_rel = TRACKER_FILE_PATH
    store_path = (store_rel if os.path.isabs(store_rel)
                  else os.path.join(ENTROPY_MACHINES_ROOT, store_rel))
    # A missing store is an empty store, not an error — same rule as
    # tracker-view.py's main() and lib/tracker-file's _load().
    store = {"issues": {}, "notes": []}
    if os.path.isfile(store_path):
        try:
            with open(store_path, encoding="utf-8") as f:
                store = json.load(f)
        except (OSError, ValueError):
            return None  # corrupt store — fall through to the static file
    project = PROJECT_NAME or os.path.basename(ENTROPY_MACHINES_ROOT)
    payload = tracker_view.build_payload(store, project, store_rel)
    # Same substitution as tracker_view.render(), but in memory — no temp
    # file, no disk I/O. The five placeholders are stable: they are the page's
    # only moving parts and are tested by tracker-render-writes-a-browsable-view.
    blob = json.dumps(payload, ensure_ascii=False,
                      sort_keys=True).replace("</", "<\\/")
    return (tracker_view.TEMPLATE
            .replace("__NAV__", tracker_view._base_nav("Issue tracker"))
            .replace("__PROJECT__",
                     html.escape(payload["project"] or "this repo"))
            .replace("__GENERATED__", html.escape(payload["generated"]))
            .replace("__STORE__", html.escape(payload["store"]))
            .replace("__DATA__", blob))


# ---------------------------------------------------------------------------
# save patch — injected at serve time, never written into a file. Keeping
# this out of the doc on disk is the whole point: no doc can be served with
# the browser's Downloads-folder save (showSaveFilePicker / <a download>)
# still wired up as the only way to save, because this always runs first,
# in the capture phase, and stopImmediatePropagation kills every listener
# behind it on the same click — including any doc's own baked-in
# __disk-save-patch, which already does the right thing but is not
# guaranteed to be present on every doc this ever serves.
# ---------------------------------------------------------------------------
SAVE_PATCH = """
<script>
(function(){
  var btn=document.getElementById('saveBtn'), stat=document.getElementById('saveStat');
  if(!btn) return;
  var file=location.pathname.replace(/^\\//,'');
  btn.addEventListener('click', function(ev){
    ev.stopImmediatePropagation(); ev.preventDefault();
    var out={};
    document.querySelectorAll('[data-resp]').forEach(function(el){
      var ta=el.querySelector('textarea'); if(!ta) return;
      var v=(ta.value||''); if(v.trim()) out[el.getAttribute('data-resp')]=v;
    });
    if(stat) stat.textContent='Saving…';
    fetch('/__save?file='+encodeURIComponent(file),
          {method:'POST',headers:{'Content-Type':'application/json'},
           body:JSON.stringify(out)})
      .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
      .then(function(j){
        if(stat) stat.textContent='Saved '+j.count+' answer(s) to '+file;
        var el=document.getElementById('responses-data');
        if(el) el.textContent=JSON.stringify(out,null,2);
      })
      .catch(function(e){ if(stat) stat.textContent='SAVE FAILED: '+e.message; });
  }, true);
})();
</script>
"""


def safe_doc_name(name: str):
    """A save endpoint that takes a path is a file-write primitive aimed at
    the whole disk — reject anything that is not a plain .html filename
    directly inside the configured docs directory. Same three rules for GET
    and POST alike: no '/', no '..', must end '.html'."""
    if not name or "/" in name or ".." in name or not name.endswith(".html"):
        return None
    return name


def doc_path(name: str):
    safe = safe_doc_name(name)
    if safe is None:
        return None
    return os.path.join(DOCS_PATH, safe)


# ---------------------------------------------------------------------------
# /__docversion — a content hash the doc's own baked-in reload watcher polls
# (see docs/SERVE.md for what happens on an older doc that lacks it:
# nothing breaks, it just never reloads on its own).
#
# WHY NOT A HASH OF THE WHOLE FILE. The reader's own 💾 rewrites the
# #responses-data block and every answered <textarea> — hash the whole file
# and saving your OWN answer changes the hash, which the watcher reads as
# "a reply arrived" and either reloads for no reason or, worse, throws up
# the dirty-changes bar over nothing. So the hash excludes exactly the two
# regions /__save owns: the #responses-data JSON block's contents, and the
# text inside every <textarea>. What is left changes only when something
# OTHER than an answer round-trip touched the file — an agent's reply
# written into the doc's prose, a new response box, a restructured section.
# ---------------------------------------------------------------------------
_RESPONSES_DATA_RE = re.compile(
    r'(<script type="application/json" id="responses-data">)(.*?)(</script>)',
    re.S,
)
_TEXTAREA_RE = re.compile(r"(<textarea\b[^>]*>)(.*?)(</textarea>)", re.S)


def doc_signature(text: str) -> str:
    stripped = _RESPONSES_DATA_RE.sub(lambda m: m.group(1) + m.group(3), text)
    stripped = _TEXTAREA_RE.sub(lambda m: m.group(1) + m.group(3), stripped)
    return hashlib.sha256(stripped.encode("utf-8")).hexdigest()


# ---------------------------------------------------------------------------
# save merge — same shape as the verified planning/serve.py reference:
# rewrite #responses-data and each matching <textarea>, atomically.
# ---------------------------------------------------------------------------
def merge(path: str, answers: dict) -> int:
    with open(path, encoding="utf-8") as f:
        doc = f.read()

    doc = _RESPONSES_DATA_RE.sub(
        lambda m: m.group(1) + json.dumps(answers, indent=1) + m.group(3),
        doc,
        count=1,
    )

    for key, val in answers.items():
        pat = re.compile(
            r'(data-resp="' + re.escape(key) + r'"[\s\S]*?<textarea[^>]*>)([\s\S]*?)(</textarea>)'
        )
        doc = pat.sub(lambda m: m.group(1) + html.escape(val) + m.group(3), doc, count=1)

    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(prefix=".serve-", dir=d)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(doc)
        os.replace(tmp, path)  # atomic: a reader never sees a torn file
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return len(answers)


# ---------------------------------------------------------------------------
# per-doc answered/unanswered counts, for the dashboard
# ---------------------------------------------------------------------------
_DATA_RESP_RE = re.compile(r'data-resp="([^"]+)"')
_COMMENT_RE = re.compile(r"<!--[\s\S]*?-->")


def doc_counts(path: str):
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return None
    # STRIP COMMENTS BEFORE COUNTING. A template's header comment may contain
    # a literal data-resp="UNIQUE-KEY" example. Counting it would make every
    # doc report one phantom unanswered question -- so "fully answered" would
    # be unreachable and the dashboard could never go green.
    keys = _DATA_RESP_RE.findall(_COMMENT_RE.sub("", text))
    total = len(keys)
    m = _RESPONSES_DATA_RE.search(text)
    answered_keys = set()
    if m:
        try:
            data = json.loads(m.group(2) or "{}")
            if isinstance(data, dict):
                answered_keys = {k for k, v in data.items() if isinstance(v, str) and v.strip()}
        except json.JSONDecodeError:
            pass
    answered = sum(1 for k in keys if k in answered_keys)
    return {"total": total, "answered": answered}


def list_docs():
    try:
        names = sorted(n for n in os.listdir(DOCS_PATH) if n.endswith(".html"))
    except OSError:
        return []
    out = []
    for n in names:
        counts = doc_counts(os.path.join(DOCS_PATH, n))
        out.append({"name": n, "counts": counts})
    return out


# ---------------------------------------------------------------------------
# tracker data for the dashboard — shells to bin/tracker exactly the way
# bin/dispatch does, so a reader sees the same "ready" and "in flight" the
# dispatcher itself enforces against, not a second opinion.
# ---------------------------------------------------------------------------
def run(cmd, input_text=None):
    try:
        return subprocess.run(
            cmd, input=input_text, capture_output=True, text=True, timeout=10, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None


def ready_issues():
    r = run([TRACKER, "ready"])
    if r is None or r.returncode != 0:
        return None
    out = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def in_flight_claims():
    """CLAIM/PATHS lines from lib/notes.py, over ALL notes — same derivation
    bin/dispatch uses: an issue's last event is a DISPATCH (still holding
    its scope) or a HANDOFF (released). 24h default expiry, matching
    DISPATCH_CLAIM_HOURS's default in bin/dispatch."""
    notes = run([TRACKER, "notes"])
    if notes is None or notes.returncode != 0:
        return None
    hours = os.environ.get("DISPATCH_CLAIM_HOURS", "24")
    r = run(["python3", NOTES_PY, "claims", "--hours", hours], input_text=notes.stdout)
    if r is None or r.returncode != 0:
        return None
    claims = []
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if parts and parts[0] == "CLAIM" and len(parts) >= 3:
            claims.append({"issue": parts[1], "paths": parts[2]})
    return claims


def recent_notes(limit=20):
    r = run([TRACKER, "notes"])
    if r is None or r.returncode != 0:
        return None
    recs = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            recs.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return recs[-limit:][::-1]


# ---------------------------------------------------------------------------
# dashboard page
# ---------------------------------------------------------------------------
# The dashboard is a viewable interface too, so it wears the same theme the
# docs do — same tokens, same file, no second palette to keep in step. The
# names it uses that a theme does not define (--fg, --link, --negative, --font)
# are mapped onto theme tokens right after, as var() references so they follow
# the toggle on their own.
PAGE_HEAD = """<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>the factory</title>
<style>
