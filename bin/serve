#!/bin/sh
# The factory lights. A local web server, not a CLI:
#
#   bin/serve [port]      # default 8787
#
#   GET  /                       SPA entry point — React Router handles
#                                 client-side routing from here.
#   /api/*                       REST endpoints for the React SPA (ui/),
#                                 reading/writing .entropy-machines/
#                                 entropy-machines.db — see lib/api.py's own
#                                 docstring for the endpoint table.
#   GET  /assets/*               SPA static assets from ui/dist/assets/.
#
set -e

usage() {
  cat >&2 <<'EOF'
usage: bin/serve [port]
EOF
  exit 2
}

case "$1" in
  -h|--help) usage ;;
esac

. "$(dirname "$0")/../lib/roots.sh"
ENTROPY_MACHINES_HOME=$(entropy_machines_home "$0")
entropy_machines_require_root serve

CONFIG_PY="$ENTROPY_MACHINES_HOME/lib/config.py"

# docs.dir has no entry in lib/config.py's DEFAULTS (that file is shared
# infrastructure, not this bullet's to extend) — so a project that has not
# set it fails config.py's "no such key" lookup, and that failure IS the
# default path, not an error to surface.
docs_dir=$(python3 "$CONFIG_PY" get docs.dir 2>/dev/null) || docs_dir="entropy-machines-docs"
case "$docs_dir" in
  /*) docs_path="$docs_dir" ;;
  *) docs_path="$ENTROPY_MACHINES_ROOT/$docs_dir" ;;
esac
mkdir -p "$docs_path"

# THEME — config-driven, not CSS files. Themes are 5-color config objects
# embedded directly in templates and applied via style.setProperty. No theme
# CSS files, no docs.theme config key needed for basic serving.

# SPA — the React frontend's production build. When ui/dist/ exists, serve its
# static files and use index.html as the SPA fallback for client-side routes.
# Check two locations: sibling to bin/ ($ENTROPY_MACHINES_HOME/ui/dist/) and
# at the project root ($ENTROPY_MACHINES_ROOT/ui/dist/). If neither exists,
# SERVE_SPA_ROOT stays empty and non-API routes return 404.
SERVE_SPA_ROOT=""
if [ -f "$ENTROPY_MACHINES_HOME/ui/dist/index.html" ]; then
  SERVE_SPA_ROOT="$ENTROPY_MACHINES_HOME/ui/dist"
elif [ -f "$ENTROPY_MACHINES_ROOT/ui/dist/index.html" ]; then
  SERVE_SPA_ROOT="$ENTROPY_MACHINES_ROOT/ui/dist"
fi

SERVE_NO_OPEN=""
port=""
for _arg in "$@"; do
  case "$_arg" in
    --no-open) SERVE_NO_OPEN=1 ;;
    *) port="$_arg" ;;
  esac
done
port="${port:-8787}"
case "$port" in
  ''|*[!0-9]*)
    echo "serve: REFUSED — port must be a number, got '$port'." >&2
    usage
    ;;
esac

export ENTROPY_MACHINES_HOME ENTROPY_MACHINES_ROOT
export SERVE_DOCS_PATH="$docs_path"
export SERVE_DOCS_DIR="$docs_dir"
export SERVE_PORT="$port"
export SERVE_NO_OPEN="$SERVE_NO_OPEN"
export SERVE_SPA_ROOT="$SERVE_SPA_ROOT"

exec python3 - <<'PY'
"""bin/serve's HTTP server, run via `python3 -` from the shell shim above.
Everything it needs — roots, docs dir, port — arrives as environment, already
resolved by bin/serve (docs/CONFIG.md rule 3: a backend never re-reads
config.json itself; this applies the same discipline to bin/serve's own
python half).
"""
from __future__ import annotations

import json
import os
import sys
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

ENTROPY_MACHINES_HOME = os.environ["ENTROPY_MACHINES_HOME"]
ENTROPY_MACHINES_ROOT = os.environ["ENTROPY_MACHINES_ROOT"]
DOCS_PATH = os.environ["SERVE_DOCS_PATH"]
DOCS_DIR = os.environ["SERVE_DOCS_DIR"]
PORT = int(os.environ["SERVE_PORT"])
# SPA — the React frontend's production build. When SPA_ROOT is set and the
# directory contains index.html, the server serves its static files at
# /assets/* and uses index.html as the SPA fallback for any route not
# matched by /api/* or /assets/*.
SPA_ROOT = os.environ.get("SERVE_SPA_ROOT", "")
SPA_INDEX = os.path.join(SPA_ROOT, "index.html") if SPA_ROOT else ""
SPA_AVAILABLE = bool(SPA_ROOT and os.path.isfile(SPA_INDEX))

# MIME types for static assets served from ui/dist/assets/.
_MIME_TYPES = {
    ".js":    "application/javascript",
    ".mjs":   "application/javascript",
    ".css":   "text/css",
    ".html":  "text/html; charset=utf-8",
    ".json":  "application/json",
    ".svg":   "image/svg+xml",
    ".png":   "image/png",
    ".jpg":   "image/jpeg",
    ".jpeg":  "image/jpeg",
    ".gif":   "image/gif",
    ".ico":   "image/x-icon",
    ".woff":  "font/woff",
    ".woff2": "font/woff2",
    ".ttf":   "font/ttf",
    ".eot":   "application/vnd.ms-fontobject",
    ".map":   "application/json",
    ".txt":   "text/plain; charset=utf-8",
}

sys.path.insert(0, os.path.join(ENTROPY_MACHINES_HOME, "lib"))

# api — /api/* REST endpoints for the React SPA (ui/), reading/writing
# .entropy-machines/entropy-machines.db. Optional import: an older checkout
# without lib/api.py or without a migrated db just gets a 404/503 on /api/*
# instead of a crash.
try:
    import api as api_module
except ImportError:
    api_module = None

# THEME — config-driven. Themes are 5-color config objects embedded directly
# in templates and applied via style.setProperty. No CSS file reading needed.


# ---------------------------------------------------------------------------
# HTTP handler
# ---------------------------------------------------------------------------
class Handler(BaseHTTPRequestHandler):
    server_version = "entropy-serve/1"

    def log_message(self, fmt, *args):
        sys.stderr.write("  %s\n" % (fmt % args))

    def _send(self, code, body: bytes, content_type: str):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, code, obj):
        self._send(code, json.dumps(obj).encode("utf-8"), "application/json")

    # ------------------------------------------------------------------
    # /api/* — REST endpoints for the React SPA, delegated to lib/api.py.
    # This method does the HTTP-layer work (query parsing, body reading,
    # status/JSON writing) common to every verb; lib/api.dispatch() does
    # not know sockets or headers exist.
    # ------------------------------------------------------------------
    def _handle_api(self, method, parsed):
        if api_module is None:
            self._send_json(404, {"error": "lib/api.py not available"})
            return
        body = None
        if method in ("POST", "PUT", "PATCH"):
            try:
                n = int(self.headers.get("Content-Length") or 0)
                raw = self.rfile.read(n) if n else b""
                body = json.loads(raw) if raw else {}
            except (ValueError, TypeError) as exc:
                self._send_json(400, {"error": "invalid JSON body: %s" % exc})
                return
        query = parse_qs(parsed.query)
        status, obj = api_module.dispatch(
            ENTROPY_MACHINES_ROOT, method, parsed.path, query, body)
        self._send_json(status, obj)

    # ------------------------------------------------------------------
    # SPA static asset serving — /assets/* from ui/dist/assets/.
    # ------------------------------------------------------------------
    def _serve_spa_asset(self, path):
        """Serve a static file from ui/dist/. Returns True if handled."""
        if not SPA_AVAILABLE:
            return False
        # Only /assets/* — never walk outside that subtree.
        if not path.startswith("/assets/"):
            return False
        # Reject path traversal.
        rel = path[1:]  # strip leading /
        if ".." in rel or "\0" in rel:
            self._send(400, b"bad request", "text/plain; charset=utf-8")
            return True
        target = os.path.join(SPA_ROOT, rel)
        # Resolve symlinks and verify the file is still under SPA_ROOT.
        try:
            real = os.path.realpath(target)
        except (OSError, ValueError):
            self._send(404, b"not found", "text/plain; charset=utf-8")
            return True
        if not real.startswith(os.path.realpath(SPA_ROOT) + os.sep):
            self._send(403, b"forbidden", "text/plain; charset=utf-8")
            return True
        if not os.path.isfile(real):
            self._send(404, b"not found", "text/plain; charset=utf-8")
            return True
        ext = os.path.splitext(real)[1].lower()
        content_type = _MIME_TYPES.get(ext, "application/octet-stream")
        with open(real, "rb") as f:
            data = f.read()
        # Vite hashes asset filenames, so they are safe to cache.
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        if "/assets/" in path:
            self.send_header("Cache-Control", "public, max-age=31536000, immutable")
        else:
            self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)
        return True

    def _serve_spa_index(self):
        """Serve ui/dist/index.html as the SPA entry point."""
        with open(SPA_INDEX, "rb") as f:
            data = f.read()
        self._send(200, data, "text/html; charset=utf-8")

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path.startswith("/api/"):
            self._handle_api("GET", parsed)
            return

        # SPA static assets — /assets/* from ui/dist/assets/.
        if path.startswith("/assets/"):
            if self._serve_spa_asset(path):
                return
            self._send(404, b"not found", "text/plain; charset=utf-8")
            return

        # SPA fallback — serves index.html so React Router can handle
        # client-side routing (/, /tracker, /prds/*, /docs/*, etc.).
        if SPA_AVAILABLE:
            self._serve_spa_index()
            return

        self._send(404, b"not found", "text/plain; charset=utf-8")

    def do_PUT(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self._handle_api("PUT", parsed)
            return
        self._send(404, b"not found", "text/plain; charset=utf-8")

    def do_PATCH(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self._handle_api("PATCH", parsed)
            return
        self._send(404, b"not found", "text/plain; charset=utf-8")

    def do_POST(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self._handle_api("POST", parsed)
            return
        self._send(404, b"not found", "text/plain; charset=utf-8")


def main(no_open=False):
    # TRY THE REQUESTED PORT, THEN SCAN UPWARD. A user running `npx
    # entropy-machines start` for the first time should not be stopped by a
    # stale process on 8787 — the server picks the next open port and says
    # which one it got. Cap at 20 attempts so a misconfigured machine gets a
    # clear error, not an infinite loop.
    MAX_ATTEMPTS = 20
    port = PORT
    server = None
    for attempt in range(MAX_ATTEMPTS):
        try:
            server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
            break
        except OSError as exc:
            if exc.errno == 48 or "Address already in use" in str(exc):
                if attempt == 0 and port == PORT:
                    print("serve: port %d busy, scanning for an open port…" % port,
                          file=sys.stderr, flush=True)
                port += 1
                continue
            print("serve: REFUSED — could not bind 127.0.0.1:%d (%s)." % (port, exc),
                  file=sys.stderr)
            sys.exit(1)
    if server is None:
        print("serve: REFUSED — ports %d–%d all busy." % (PORT, PORT + MAX_ATTEMPTS - 1),
              file=sys.stderr)
        sys.exit(1)
    # flush=True IS THE POINT OF THESE TWO LINES. Python block-buffers stdout
    # when it is not a tty — which is exactly the case a bootstrapping agent
    # hits: `bin/serve &> serve.log &`, then read the URL out of the file and
    # hand it to the human. Without the flush the buffer is never filled and
    # never drained, because the very next statement blocks in serve_forever()
    # forever; the log stays 0 bytes while the server runs and 0 bytes after
    # it is killed. The URL is the one thing this command exists to produce.
    print("serving %s on http://localhost:%d" % (ENTROPY_MACHINES_ROOT, port), flush=True)
    print("  docs: %s (%s)" % (DOCS_PATH, DOCS_DIR), flush=True)
    print("  theme: config-driven (5-color, embedded in templates)", flush=True)
    if SPA_AVAILABLE:
        print("  spa: %s" % SPA_ROOT, flush=True)
        if os.path.isfile(os.path.join(DOCS_PATH, "PRD-001-orientation.html")):
            print("  start here: http://localhost:%d/prds/PRD-001-orientation" % port,
                  flush=True)
    else:
        print("  spa: not found (SPA build missing — run `npm run build` in ui/)",
              flush=True)
    if not no_open:
        def _open_browser():
            webbrowser.open("http://localhost:%d/" % port)
        threading.Thread(target=_open_browser, daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main(no_open=bool(os.environ.get("SERVE_NO_OPEN")))
PY
