  #theme-sel{float:right;background:var(--bg);border:1px solid var(--accent);color:var(--fg);
    padding:.35rem .7rem;cursor:pointer;font:600 var(--fs-sm) var(--font);}
</style>
<script>
(function(){
  var THEMES={"janus-light":{bg:"#faf9fc",fg:"#18181b",accent:"#7c3aed",positive:"#0A5C21",negative:"#b91c1c"},"janus-dark":{bg:"#0a0a0d",fg:"#fafafa",accent:"#a78bfa",positive:"#23D18B",negative:"#ef4444"},"hc-dark":{bg:"#000000",fg:"#ffffff",accent:"#21A6FF",positive:"#23D18B",negative:"#F48771"},"daylight":{bg:"#FAF8F4",fg:"#23262E",accent:"#2A5DB0",positive:"#0B6E5A",negative:"#8C1D18"},"daylight-dark":{bg:"#14161A",fg:"#E6E3DC",accent:"#7FB2F0",positive:"#34A98D",negative:"#FF8C82"}};
  function applyTheme(name){
    var t=THEMES[name]; if(!t) return;
    var s=document.documentElement.style;
    s.setProperty('--bg',t.bg); s.setProperty('--fg',t.fg);
    s.setProperty('--accent',t.accent); s.setProperty('--positive',t.positive);
    s.setProperty('--negative',t.negative);
    try{localStorage.setItem('entropy-machines-theme',name);}catch(e){}
  }
  try{var n=localStorage.getItem('entropy-machines-theme');if(n&&THEMES[n])applyTheme(n);}catch(e){}
  window.__THEMES=THEMES; window.__applyTheme=applyTheme;
})();
</script>
</head><body>
<select id="theme-sel"></select>
<script>
(function(){
  var sel=document.getElementById('theme-sel');
  var THEMES=window.__THEMES;
  Object.keys(THEMES).forEach(function(n){
    var o=document.createElement('option'); o.value=n; o.textContent=n; sel.appendChild(o);
  });
  var saved; try{saved=localStorage.getItem('entropy-machines-theme');}catch(e){}
  if(saved&&THEMES[saved]) sel.value=saved;
  sel.addEventListener('change',function(){window.__applyTheme(sel.value);});
})();
</script>
"""

PAGE_TAIL = "</body></html>\n"


def esc(s):
    return html.escape(str(s), quote=True)


def render_dashboard() -> str:
    ready = ready_issues()
    claims = in_flight_claims()
    notes = recent_notes()
    docs = list_docs()

    parts = [PAGE_HEAD]
    parts.append(f"<h1>the factory</h1>\n<p class=\"sub\">{esc(ENTROPY_MACHINES_ROOT)}</p>\n")

    parts.append("<h2>ready</h2>\n")
    if ready is None:
        parts.append('<p class="unavailable">tracker unavailable — could not run `bin/tracker ready`.</p>\n')
    elif not ready:
        parts.append('<p class="empty">nothing ready — every issue is done, blocked, held or gated.</p>\n')
    else:
        parts.append("<table><tr><th>id</th><th>title</th><th>effort</th></tr>\n")
        for issue in ready:
            parts.append(
                f"<tr><td class=\"mono\">{esc(issue.get('id',''))}</td>"
                f"<td>{esc(issue.get('title',''))}</td>"
                f"<td class=\"mono\">{esc(issue.get('effort',''))}</td></tr>\n"
            )
        parts.append("</table>\n")

    parts.append("<h2>in flight</h2>\n")
    if claims is None:
        parts.append('<p class="unavailable">tracker unavailable — could not derive live claims.</p>\n')
    elif not claims:
        parts.append('<p class="empty">nothing dispatched right now (or every dispatch has been handed off).</p>\n')
    else:
        parts.append("<table><tr><th>issue</th><th>scope held</th></tr>\n")
        for c in claims:
            parts.append(
                f"<tr><td class=\"mono\">{esc(c['issue'])}</td><td class=\"mono\">{esc(c['paths'])}</td></tr>\n"
            )
        parts.append("</table>\n")

    parts.append(f"<h2>docs ({esc(DOCS_DIR)})</h2>\n")
    if not docs:
        parts.append(f'<p class="empty">no .html docs in {esc(DOCS_DIR)}.</p>\n')
    else:
        parts.append("<table><tr><th>doc</th><th>answered</th></tr>\n")
        for d in docs:
            c = d["counts"]
            if c is None or c["total"] == 0:
                status = '<span class="empty">no questions</span>'
            elif c["answered"] >= c["total"]:
                status = f'<span class="pos">{c["answered"]}/{c["total"]} answered</span>'
            else:
                status = f'<span class="caution">{c["answered"]}/{c["total"]} answered</span>'
            parts.append(
                f"<tr><td><a href=\"/{esc(d['name'])}\">{esc(d['name'])}</a></td><td>{status}</td></tr>\n"
            )
        parts.append("</table>\n")

    parts.append("<h2>recent events</h2>\n")
    if notes is None:
        parts.append('<p class="unavailable">tracker unavailable — could not run `bin/tracker notes`.</p>\n')
    elif not notes:
        parts.append('<p class="empty">no notes recorded yet.</p>\n')
    else:
        parts.append("<table><tr><th>ts</th><th>verb</th><th>issue</th><th>actor</th></tr>\n")
        for rec in notes:
            parts.append(
                f"<tr><td class=\"mono\">{esc(rec.get('ts',''))}</td>"
                f"<td class=\"mono\">{esc(rec.get('verb',''))}</td>"
                f"<td class=\"mono\">{esc(rec.get('issue',''))}</td>"
                f"<td class=\"mono\">{esc(rec.get('actor',''))}</td></tr>\n"
            )
        parts.append("</table>\n")

    parts.append(PAGE_TAIL)
    return "".join(parts)


# ---------------------------------------------------------------------------
# HTTP handler
# ---------------------------------------------------------------------------
class Handler(BaseHTTPRequestHandler):
    server_version = "entropy-serve/1"

    def log_message(self, fmt, *args):
        sys.stderr.write("  %s\n" % (fmt % args))

    def _send(self, code, body: bytes, content_type: str):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, code, obj):
        self._send(code, json.dumps(obj).encode("utf-8"), "application/json")

    # ------------------------------------------------------------------
    # /api/* — REST endpoints for the React SPA, delegated to lib/api.py.
    # This method does the HTTP-layer work (query parsing, body reading,
    # status/JSON writing) common to every verb; lib/api.dispatch() does
    # not know sockets or headers exist.
    # ------------------------------------------------------------------
    def _handle_api(self, method, parsed):
        if api_module is None:
            self._send_json(404, {"error": "lib/api.py not available"})
            return
        body = None
        if method in ("POST", "PUT", "PATCH"):
            try:
                n = int(self.headers.get("Content-Length") or 0)
                raw = self.rfile.read(n) if n else b""
                body = json.loads(raw) if raw else {}
            except (ValueError, TypeError) as exc:
                self._send_json(400, {"error": "invalid JSON body: %s" % exc})
                return
        query = parse_qs(parsed.query)
        status, obj = api_module.dispatch(
            ENTROPY_MACHINES_ROOT, method, parsed.path, query, body)
        self._send_json(status, obj)

    # ------------------------------------------------------------------
    # SPA static asset serving — /assets/* from ui/dist/assets/.
    # ------------------------------------------------------------------
    def _serve_spa_asset(self, path):
        """Serve a static file from ui/dist/. Returns True if handled."""
        if not SPA_AVAILABLE:
            return False
        # Only /assets/* — never walk outside that subtree.
        if not path.startswith("/assets/"):
            return False
        # Reject path traversal.
        rel = path[1:]  # strip leading /
        if ".." in rel or "\0" in rel:
            self._send(400, b"bad request", "text/plain; charset=utf-8")
            return True
        target = os.path.join(SPA_ROOT, rel)
        # Resolve symlinks and verify the file is still under SPA_ROOT.
        try:
            real = os.path.realpath(target)
        except (OSError, ValueError):
            self._send(404, b"not found", "text/plain; charset=utf-8")
            return True
        if not real.startswith(os.path.realpath(SPA_ROOT) + os.sep):
            self._send(403, b"forbidden", "text/plain; charset=utf-8")
            return True
        if not os.path.isfile(real):
            self._send(404, b"not found", "text/plain; charset=utf-8")
            return True
        ext = os.path.splitext(real)[1].lower()
        content_type = _MIME_TYPES.get(ext, "application/octet-stream")
        with open(real, "rb") as f:
            data = f.read()
        # Vite hashes asset filenames, so they are safe to cache.
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        if "/assets/" in path:
            self.send_header("Cache-Control", "public, max-age=31536000, immutable")
        else:
            self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)
        return True

    def _serve_spa_index(self):
        """Serve ui/dist/index.html as the SPA entry point."""
        with open(SPA_INDEX, "rb") as f:
            data = f.read()
        self._send(200, data, "text/html; charset=utf-8")

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path.startswith("/api/"):
            self._handle_api("GET", parsed)
            return

        # SPA static assets — /assets/* from ui/dist/assets/.
        if path.startswith("/assets/"):
            if self._serve_spa_asset(path):
                return
            self._send(404, b"not found", "text/plain; charset=utf-8")
            return

        if path == "/":
            # When ui/dist/ exists, serve the SPA entry point — React Router
            # handles client-side routing from here.
            if SPA_AVAILABLE:
                self._serve_spa_index()
                return
            # Legacy dashboard: when the tracker is empty (first contact), go
            # straight to the PRD.
            ready = ready_issues()
            if not ready:
                import glob
                prds = sorted(glob.glob(os.path.join(DOCS_PATH, "PRD-*.html")))
                if prds:
                    self.send_response(302)
                    self.send_header("Location", "/%s" % os.path.basename(prds[0]))
                    self.end_headers()
                    return
            self._send(200, render_dashboard().encode("utf-8"), "text/html; charset=utf-8")
            return

        if path == "/__docversion":
            name = (parse_qs(parsed.query).get("file") or [""])[0]
            target = doc_path(name)
            if target is None or not os.path.isfile(target):
                self._send_json(404, {"error": "no such doc"})
                return
            with open(target, encoding="utf-8") as f:
                text = f.read()
            self._send_json(200, {"reviews": doc_signature(text)})
            return

        if path == "/__docstatus":
            self._docstatus_get(parsed)
            return

        # TRACKER.html — rendered dynamically from live issues.json so changes
        # show up immediately, without needing `bin/tracker render`.
        if path == "/TRACKER.html":
            try:
                body = render_tracker_live()
            except Exception as exc:
                sys.stderr.write("  tracker live render failed: %s\n" % exc)
                body = None
            if body is not None:
                self._send(200, body.encode("utf-8"),
                           "text/html; charset=utf-8")
                return
            # Fall through: serve the static file if it exists in the docs dir.

        # a bare filename request — serve .html docs from the docs directory.
        name = path.lstrip("/")
        target = doc_path(name)
        if target is not None and os.path.isfile(target):
            with open(target, encoding="utf-8") as f:
                body = f.read()
            if "</body>" in body:
                body = body.replace("</body>", SAVE_PATCH + "</body>", 1)
            else:
                body += SAVE_PATCH
            self._send(200, body.encode("utf-8"), "text/html; charset=utf-8")
            return

        # SPA fallback — any route not matched above serves index.html so
        # React Router can handle client-side routing (/tracker, /prds/*,
        # /reports/*, /docs/*, etc.).
        if SPA_AVAILABLE:
            self._serve_spa_index()
            return

        self._send(404, b"not found", "text/plain; charset=utf-8")

    def do_PUT(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self._handle_api("PUT", parsed)
            return
        self._send(404, b"not found", "text/plain; charset=utf-8")

    def do_PATCH(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self._handle_api("PATCH", parsed)
            return
        self._send(404, b"not found", "text/plain; charset=utf-8")

    def do_POST(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self._handle_api("POST", parsed)
            return
        if parsed.path == "/__docstatus":
            self._docstatus_post(parsed)
            return
        if parsed.path != "/__save":
            self._send(404, b"not found", "text/plain; charset=utf-8")
            return
        name = (parse_qs(parsed.query).get("file") or [""])[0]
        target = doc_path(name)
        if target is None:
            self._send_json(400, {"error": "bad file"})
            return
        if not os.path.isfile(target):
            self._send_json(404, {"error": "no such doc"})
            return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            answers = json.loads(self.rfile.read(n) or b"{}")
            if not isinstance(answers, dict):
                raise ValueError("expected an object")
            count = merge(target, answers)
        except Exception as exc:  # noqa: BLE001 - report, don't crash the server
            self._send_json(500, {"error": str(exc)})
            return
        # --- docstate: snapshot + status flip after a successful save ---
        if docstate is not None:
            try:
                docstate.on_save(name)
            except Exception:  # noqa: BLE001 - never fail the save for bookkeeping
                pass
        self._send_json(200, {"ok": True, "count": count})

    # ------------------------------------------------------------------
    # /__docstatus — read or write the doc-level status from the browser.
    # GET  /__docstatus?file=X        → {"status":"open", ...}
    # POST /__docstatus  {file,status} → {"ok":true,"status":"open"}
    # ------------------------------------------------------------------
    def _docstatus_get(self, parsed):
        if docstate is None:
            self._send_json(404, {"error": "docstate not available"})
            return
        name = (parse_qs(parsed.query).get("file") or [""])[0]
        safe = safe_doc_name(name)
        if safe is None:
            self._send_json(400, {"error": "bad file"})
            return
        try:
            m = docstate.load()
        except Exception:  # noqa: BLE001
            self._send_json(404, {"error": "no manifest"})
            return
        did = next((d for d, e in m["docs"].items() if e.get("file") == safe), None)
        if did is None:
            self._send_json(404, {"error": "doc not in manifest"})
            return
        entry = m["docs"][did]
        self._send_json(200, {
            "status": entry.get("status", ""),
            "version": entry.get("version", 0),
            "handle": entry.get("handle", did),
            "updatedAt": entry.get("updatedAt", ""),
        })

    def _docstatus_post(self, parsed):
        if docstate is None:
            self._send_json(404, {"error": "docstate not available"})
            return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or b"{}")
            if not isinstance(body, dict):
                raise ValueError("expected an object")
        except Exception as exc:  # noqa: BLE001
            self._send_json(400, {"error": str(exc)})
            return
        name = body.get("file", "")
        status = body.get("status", "")
        safe = safe_doc_name(name)
        if safe is None:
            self._send_json(400, {"error": "bad file"})
            return
        if status not in docstate.STATUS:
            self._send_json(400, {"error": "unknown status %r; one of %s" % (status, list(docstate.STATUS))})
            return
        try:
            m = docstate.load()
        except Exception:  # noqa: BLE001
            self._send_json(404, {"error": "no manifest"})
            return
        did = next((d for d, e in m["docs"].items() if e.get("file") == safe), None)
        if did is None:
            self._send_json(404, {"error": "doc not in manifest"})
            return
        try:
            docstate.set_status(m, did, status)
        except Exception as exc:  # noqa: BLE001
            self._send_json(500, {"error": str(exc)})
            return
        self._send_json(200, {"ok": True, "status": status})


def main(no_open=False):
    # TRY THE REQUESTED PORT, THEN SCAN UPWARD. A user running `npx
    # entropy-machines start` for the first time should not be stopped by a
    # stale process on 8787 — the server picks the next open port and says
    # which one it got. Cap at 20 attempts so a misconfigured machine gets a
    # clear error, not an infinite loop.
    MAX_ATTEMPTS = 20
    port = PORT
    server = None
    for attempt in range(MAX_ATTEMPTS):
        try:
            server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
            break
        except OSError as exc:
            if exc.errno == 48 or "Address already in use" in str(exc):
                if attempt == 0 and port == PORT:
                    print("serve: port %d busy, scanning for an open port…" % port,
                          file=sys.stderr, flush=True)
                port += 1
                continue
            print("serve: REFUSED — could not bind 127.0.0.1:%d (%s)." % (port, exc),
                  file=sys.stderr)
            sys.exit(1)
    if server is None:
        print("serve: REFUSED — ports %d–%d all busy." % (PORT, PORT + MAX_ATTEMPTS - 1),
              file=sys.stderr)
        sys.exit(1)
    # flush=True IS THE POINT OF THESE TWO LINES. Python block-buffers stdout
    # when it is not a tty — which is exactly the case a bootstrapping agent
    # hits: `bin/serve &> serve.log &`, then read the URL out of the file and
    # hand it to the human. Without the flush the buffer is never filled and
    # never drained, because the very next statement blocks in serve_forever()
    # forever; the log stays 0 bytes while the server runs and 0 bytes after
    # it is killed. The URL is the one thing this command exists to produce.
    print("serving %s on http://localhost:%d" % (ENTROPY_MACHINES_ROOT, port), flush=True)
    print("  docs: %s (%s)" % (DOCS_PATH, DOCS_DIR), flush=True)
    print("  theme: config-driven (5-color, embedded in templates)", flush=True)
    if SPA_AVAILABLE:
        print("  spa: %s" % SPA_ROOT, flush=True)
    else:
        print("  spa: not found (legacy doc serving only)", flush=True)
    if not no_open:
        def _open_browser():
            import glob
            prds = sorted(glob.glob(os.path.join(DOCS_PATH, "PRD-*.html")))
            if prds:
                target = "http://localhost:%d/%s" % (port, os.path.basename(prds[0]))
            else:
                target = "http://localhost:%d/" % port
            webbrowser.open(target)
        threading.Thread(target=_open_browser, daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main(no_open=bool(os.environ.get("SERVE_NO_OPEN")))
PY
