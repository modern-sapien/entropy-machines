#!/bin/sh
# bin/worktree-gc — garbage-collect orphaned agent worktrees.
#
#   bin/worktree-gc              remove orphaned worktrees
#   bin/worktree-gc --dry-run    list what would be removed
#   bin/worktree-gc --all        remove ALL agent worktrees, not just orphans
#   bin/worktree-gc --max-age N  override the age threshold (hours, default 24)
#
# An agent worktree (.claude/worktrees/agent-*) is ORPHANED if any of:
#
#   1. It contains a HANDOFF.md — the agent finished its work, and the
#      worktree's edits have either been lifted or are no longer needed.
#   2. It is older than --max-age hours AND has no .dispatch-issue marker —
#      a worktree with no marker was never claimed by the auto-verifier, so
#      either the agent crashed before writing it or the session that created
#      the worktree is long gone.
#
# The age is measured from the directory's modification time, which git
# updates on creation and the agent updates on every file write. A worktree
# that is still being actively written to will not be stale by this measure.
#
# ONLY .claude/worktrees/agent-* directories are touched. Anything outside
# that pattern — a human's worktree, a worktree managed by another tool — is
# left alone regardless of its age or contents.
#
# WHY THIS EXISTS. A sprint that dispatches 40 agents leaves 40 worktrees
# behind, each carrying a full checkout. The disk cost is real (measured at
# ~15 MB per worktree in this repo), and the git branch namespace is
# cluttered with `worktree-agent-*` branches that serve no purpose after the
# worktree is gone. bin/handoff now cleans up the source worktree after a
# successful --verified record, but that only covers the happy path. An agent
# that crashes, times out, or is abandoned leaves its worktree forever. This
# is the sweep for everything bin/handoff's auto-cleanup missed.

set -e

usage() {
  echo "usage: bin/worktree-gc [--dry-run] [--all] [--max-age <hours>]" >&2
  exit 2
}

dry=0; all=0; max_age=24
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --all)     all=1; shift ;;
    --max-age) max_age="$2"; shift 2 ;;
    -h|--help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) usage ;;
  esac
done

case "$max_age" in ''|*[!0-9]*) echo "worktree-gc: --max-age must be a positive integer" >&2; exit 2 ;; esac

. "$(dirname "$0")/../lib/roots.sh"
ENTROPY_MACHINES_HOME=$(entropy_machines_home "$0")
entropy_machines_require_root worktree-gc

wt_dir="$ENTROPY_MACHINES_ROOT/.claude/worktrees"
if [ ! -d "$wt_dir" ]; then
  echo "worktree-gc: no .claude/worktrees/ directory — nothing to do."
  exit 0
fi

# Current time in seconds since epoch.
now=$(date +%s)
cutoff=$((now - max_age * 3600))

removed=0
skipped=0
errors=0

for d in "$wt_dir"/agent-*; do
  [ -d "$d" ] || continue
  d_abs=$(cd "$d" 2>/dev/null && pwd -P) || continue
  d_name=$(basename "$d")

  reason=""

  if [ "$all" -eq 1 ]; then
    reason="--all"
  elif [ -f "$d/HANDOFF.md" ]; then
    reason="HANDOFF.md present (agent finished)"
  else
    # Check age. stat -f %m is BSD (macOS), stat -c %Y is GNU (Linux).
    mtime=$(stat -f %m "$d" 2>/dev/null || stat -c %Y "$d" 2>/dev/null || echo 0)
    if [ "$mtime" -le "$cutoff" ]; then
      if [ ! -f "$d/.dispatch-issue" ]; then
        reason="older than ${max_age}h with no .dispatch-issue"
      fi
    fi
  fi

  if [ -z "$reason" ]; then
    skipped=$((skipped + 1))
    continue
  fi

  wt_branch="worktree-$d_name"

  if [ "$dry" -eq 1 ]; then
    echo "  would remove  $d_name  ($reason)"
    removed=$((removed + 1))
    continue
  fi

  # Remove the worktree properly. --force is needed because agent worktrees
  # typically have uncommitted changes (the agent's edits).
  if git -C "$ENTROPY_MACHINES_ROOT" worktree remove --force "$d_abs" 2>/dev/null; then
    echo "  removed  $d_name  ($reason)"
  else
    # Fall back to manual removal if git worktree remove fails.
    rm -rf "$d_abs" 2>/dev/null
    git -C "$ENTROPY_MACHINES_ROOT" worktree prune 2>/dev/null || true
    if [ -d "$d_abs" ]; then
      echo "  FAILED   $d_name  (could not remove)" >&2
      errors=$((errors + 1))
      continue
    fi
    echo "  removed  $d_name  (manual, $reason)"
  fi

  # Delete the per-worktree branch.
  if git -C "$ENTROPY_MACHINES_ROOT" rev-parse --verify "$wt_branch" >/dev/null 2>&1; then
    git -C "$ENTROPY_MACHINES_ROOT" branch -D "$wt_branch" 2>/dev/null && \
      echo "  deleted branch  $wt_branch" || true
  fi

  removed=$((removed + 1))
done

prefix="worktree-gc:"
[ "$dry" -eq 1 ] && prefix="worktree-gc (dry-run):"
echo "$prefix $removed removed, $skipped kept, $errors errors."
[ "$errors" -gt 0 ] && exit 1
exit 0
