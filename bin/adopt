#!/usr/bin/env python3
"""adopt — make the harness DROP-IN: point a user's coding agent at it.

  bin/adopt [claude|codex|cursor|all]   install/update (default: detect what
                                         is present in the project)
  bin/adopt --check [<target> ...]      missing|stale|current per target;
                                         exit 0 iff every requested target is
                                         current, else 1
  bin/adopt --remove [<target> ...]     remove ONLY our blocks/files
  bin/adopt --dry-run                   print what would be written, write
                                         nothing, never prompts
  bin/adopt --yes                       skip the confirmation prompt
  bin/adopt prime                       print live factory state (issues
                                         ready, in flight, docs with
                                         unanswered questions); used by the
                                         Claude Code SessionStart hook this
                                         installs for `claude` — not meant to
                                         be run by a human, but harmless if
                                         you do

WHAT THIS BUYS. A user copies this harness into their repo and runs one
command; their coding agent then knows the factory exists and how to use it
— without the agent having to go looking, and without bloating whatever
instruction file it already reads. Design lifted deliberately from `beads`
(github.com/gastownhall/beads): a HASHED MANAGED BLOCK bounded by
`<!-- BEGIN ENTROPY-MACHINES v:1 profile:<name> hash:<8 hex> -->` /
`<!-- END ENTROPY-MACHINES -->` markers, written into a file the user owns.
The hash is over the block's own rendered body — re-render from the current
lib/agent-block.md against the current harness path and compare, which is
what makes --check able to say missing / stale / current instead of just
present-or-not, and what makes re-install idempotent (update in place, never
a second copy) and --remove precise (delete only what is between our own
markers, nothing else).

TWO PROFILES, because a rule pasted directly into an agent's brief lands
far more often than the same rule left in an instruction file for the agent
to go read on its own (measured on this project: 96% vs 7%). Runners with a
session-start hook (Claude Code) get "minimal" — a short pointer, because the
hook itself pushes live state every session. Runners without one (Codex,
Cursor) get "full" — the same pointer plus the command syntax inline, since
nothing else is going to tell them. See lib/agent-block.md for the actual
text of both profiles — this file only assembles, hashes, installs, checks
and removes it; edit the words there, not here.

| Target | File                        | Profile | Extra                      |
|--------|-----------------------------|---------|-----------------------------|
| claude | CLAUDE.md                   | minimal | .claude/settings.json       |
|        |                              |         | SessionStart hook -> `prime`|
| codex  | AGENTS.md                   | full    | -                            |
| cursor | .cursor/rules/entropy.mdc   | full    | file is FULLY OWNED by us — |
|        |                              |         | no markers needed, whole    |
|        |                              |         | file is the payload         |

CONSENT IS REQUIRED. By default this PRINTS exactly what it will write and to
which files and waits for a y/N answer before writing anything. --yes skips
the prompt (for scripted/CI use); --dry-run prints and exits without ever
prompting or writing. Nothing is written on a declined or unanswered prompt.

Exit codes: install/remove — 0 wrote or nothing to do, 1 declined/nothing
written, 2 misuse or refusal (e.g. malformed settings.json). check — 0 all
requested targets current, 1 at least one missing/stale, 2 misuse.
"""
import hashlib
import json
import os
import re
import subprocess
import sys

# THERE ARE TWO ROOTS AND THEY ARE NOT THE SAME -- see lib/roots.sh, which
# this block mirrors for the shell entry points (bin/post-fold-audit carries
# the same mirror; kept in sync by hand, not shared, because roots.sh is
# meant to be SOURCED by sh and this is python). ENTROPY_HOME is this
# harness's own install location, resolved from this file's own path.
# ENTROPY_PROJECT is the project being adopted INTO.
#
# Deliberately the LENIENT project resolver (no entropy.json required), not
# lib/roots.sh's entropy_require_project()/this file's _require_project()
# twin used elsewhere in the harness: adopt is meant to be runnable as the
# very first command after vendoring the harness in, before `bin/init` has
# ever created an entropy.json. All it needs is to be inside a git repo (or
# under a directory that already has entropy.json, for the case where init
# ran first).
ENTROPY_HOME = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

BLOCK_MARKER = "ENTROPY-MACHINES"
BLOCK_VERSION = 1
AGENT_BLOCK_MD = os.path.join(ENTROPY_HOME, "lib", "agent-block.md")


def _entropy_project():
    """Mirrors lib/roots.sh's entropy_project(): the project's main checkout
    root, or None. ENTROPY_PROJECT in the environment wins. Otherwise `git
    rev-parse --git-common-dir` -- NOT --show-toplevel, which prints a linked
    WORKTREE's own path. Falls back to walking up for entropy.json when
    there is no git."""
    env = os.environ.get("ENTROPY_PROJECT")
    if env:
        return os.path.abspath(env)
    try:
        p = subprocess.run(
            ["git", "rev-parse", "--git-common-dir"],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        p = None
    if p is not None and p.returncode == 0 and p.stdout.strip():
        common = p.stdout.strip()
        if not os.path.isabs(common):
            common = os.path.join(os.getcwd(), common)
        return os.path.realpath(os.path.join(common, os.pardir))
    d = os.getcwd()
    while True:
        if os.path.exists(os.path.join(d, "entropy.json")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def require_project(tool="adopt"):
    project = _entropy_project()
    if not project:
        print("%s: REFUSED -- not inside a git repository, and no entropy.json "
              "found by walking up from %s." % (tool, os.getcwd()), file=sys.stderr)
        print("  cd into the project you want to adopt the factory into, or set "
              "ENTROPY_PROJECT to its root.", file=sys.stderr)
        sys.exit(2)
    return project


# --- lib/agent-block.md parsing --------------------------------------------

def load_profiles():
    """Parse lib/agent-block.md's @@profile:<name> ... @@end sections into a
    dict {name: raw_template_text}. Each section's text is exactly the lines
    between its @@profile: directive and the next @@ directive, joined with
    "\n", with exactly one leading/trailing blank line trimmed (so authors
    can leave a readable blank line after the directive without it becoming
    part of the rendered block)."""
    if not os.path.isfile(AGENT_BLOCK_MD):
        print("adopt: REFUSED -- %s is missing. That file is the one source "
              "of the text this installs; nothing can be rendered without "
              "it." % AGENT_BLOCK_MD, file=sys.stderr)
        sys.exit(2)
    with open(AGENT_BLOCK_MD, encoding="utf-8") as f:
        text = f.read()
    profiles = {}
    current = None
    buf = []
    for line in text.splitlines():
        if line.startswith("@@profile:"):
            if current is not None:
                profiles[current] = "\n".join(buf).strip("\n")
            current = line[len("@@profile:"):].strip()
            buf = []
        elif line.strip() == "@@end":
            if current is not None:
                profiles[current] = "\n".join(buf).strip("\n")
            current = None
            buf = []
        elif current is not None:
            buf.append(line)
    if current is not None:
        profiles[current] = "\n".join(buf).strip("\n")
    return profiles


def harness_path_for(project):
    """How the injected block should refer to the harness.

    RELATIVE ONLY WHEN THE HARNESS IS INSIDE THE PROJECT. That is the vendored
    layout, where a relative path is correct, portable, and safe to commit --
    it means the same thing on every machine that clones the repo.

    Anywhere else (a sibling clone, a shared checkout elsewhere on disk) an
    unconditional relpath produced things like
    `../../../../../../../Users/someone/code/entropy-machines/doctrine/`: it
    leaks the author's home directory into a file the user COMMITS, and it
    breaks for every other clone of that repo. An absolute path is no more
    portable, but it is honest about being machine-local instead of looking
    like a repo-relative path that should work."""
    home = os.path.realpath(ENTROPY_HOME)
    proj = os.path.realpath(project)
    if home == proj or home.startswith(proj + os.sep):
        return os.path.relpath(home, proj).replace(os.sep, "/")
    return home.replace(os.sep, "/")


def docs_dir_for(project):
    """entropy.json's docs.dir, defaulting to entropy-docs -- the same default
    bin/init writes to and bin/serve reads from. Never raises: this runs on
    every session start and must not be able to break one."""
    try:
        with open(os.path.join(project, "entropy.json"), encoding="utf-8") as f:
            cfg = json.load(f)
        d = (cfg.get("docs") or {}).get("dir")
        if isinstance(d, str) and d.strip():
            return d.strip().strip("/")
    except Exception:
        pass
    return "entropy-docs"


def render(profile_name, project):
    profiles = load_profiles()
    if profile_name not in profiles:
        print("adopt: REFUSED -- lib/agent-block.md has no @@profile:%s "
              "section." % profile_name, file=sys.stderr)
        sys.exit(2)
    body = profiles[profile_name]
    hp = harness_path_for(project)
    return body.replace("{{HARNESS_PATH}}", hp)


def body_hash(body):
    return hashlib.sha256(body.encode("utf-8")).hexdigest()[:8]


def begin_line(profile_name, h):
    return "<!-- BEGIN %s v:%d profile:%s hash:%s -->" % (
        BLOCK_MARKER, BLOCK_VERSION, profile_name, h)


END_LINE = "<!-- END %s -->" % BLOCK_MARKER


def block_text(profile_name, project):
    body = render(profile_name, project)
    h = body_hash(body)
    return "%s\n%s\n%s" % (begin_line(profile_name, h), body, END_LINE), h


# Matches ONLY the marker lines and everything between them -- no leading or
# trailing whitespace/newlines captured, so an in-place replace via this
# pattern touches nothing else in the file, byte for byte.
BLOCK_RE = re.compile(
    r"<!-- BEGIN %s v:(\d+) profile:(\S+) hash:([0-9a-f]{8}) -->\n"
    r"(.*?)\n"
    r"<!-- END %s -->" % (re.escape(BLOCK_MARKER), re.escape(BLOCK_MARKER)),
    re.DOTALL,
)


def find_block(content):
    """Returns a re.Match or None for the FIRST managed block in content.
    (Other tools' blocks, and a second stray copy of our own, are left
    alone / reported, never silently merged.)"""
    return BLOCK_RE.search(content)


# --- block-file targets (CLAUDE.md, AGENTS.md): insert / replace / remove --

def insert_or_replace_block(content, new_block, new_hash):
    """Returns (new_content, action) where action is 'installed' (fresh
    append) or 'updated' (in-place replace, e.g. re-running on an unchanged
    or a stale block)."""
    m = find_block(content)
    if m is None:
        if content == "":
            return new_block + "\n", "installed"
        stripped = content.rstrip("\n")
        return stripped + "\n\n" + new_block + "\n", "installed"
    # In-place replace: only the matched span changes. Everything before and
    # after -- including whatever separator whitespace surrounds it -- is
    # untouched, so a second install/update never moves the block and never
    # perturbs unrelated content.
    start, end = m.span()
    return content[:start] + new_block + content[end:], "updated"


def remove_block(content):
    """Returns (new_content_or_None, removed_bool). None means "delete the
    whole file" (nothing but our block, plus the whitespace we added around
    it, was ever in it).

    Reverses insert_or_replace_block's fresh-append transform exactly for
    the common case (original file already ended in a single trailing
    newline): trims exactly one of the two newlines that formed the blank
    line we added before the block, and exactly one newline after it (the
    EOF newline we added). Documented limit: a file with unusual trailing
    whitespace before adoption (no trailing newline, or more than one blank
    line) is not guaranteed to restore byte-for-byte -- see docs/ADOPT.md.
    """
    m = find_block(content)
    if m is None:
        return content, False
    start, end = m.span()
    pre = content[:start]
    if pre.endswith("\n\n"):
        start -= 1
    tail = content[end:]
    if tail.startswith("\n"):
        end += 1
    new_content = content[:start] + content[end:]
    if new_content.strip("\n") == "":
        return None, True
    return new_content, True


# --- owned-file target (Cursor): we own the whole file, no markers ---------

CURSOR_HEADER = (
    "---\n"
    "description: entropy-machines factory — how work moves through this repo\n"
    "alwaysApply: true\n"
    "---\n"
)


def render_cursor(project):
    body = render("full", project)
    return CURSOR_HEADER + "\n" + body + "\n"


# --- targets ----------------------------------------------------------------

def claude_md_path(project):
    return os.path.join(project, "CLAUDE.md")


def agents_md_path(project):
    return os.path.join(project, "AGENTS.md")


def cursor_rule_path(project):
    return os.path.join(project, ".cursor", "rules", "entropy.mdc")


def settings_json_path(project):
    return os.path.join(project, ".claude", "settings.json")


TARGETS = ["claude", "codex", "cursor"]


def detect_targets(project):
    """Default target set for install mode when none is named: whichever of
    claude/.claude and cursor/.cursor already show a signal that tool is in
    use. codex (AGENTS.md) is the fallback default -- it is the primary,
    real cross-tool standard per the design doc -- so a repo with NONE of
    the three signals still gets at least that one file rather than
    installing nothing and looking like a no-op."""
    found = []
    if os.path.isfile(claude_md_path(project)) or os.path.isdir(os.path.join(project, ".claude")):
        found.append("claude")
    if os.path.isdir(os.path.join(project, ".cursor")):
        found.append("cursor")
    if os.path.isfile(agents_md_path(project)) or not found:
        found.append("codex")
    # de-dup, stable order
    seen = set()
    ordered = []
    for t in ["claude", "codex", "cursor"]:
        if t in found and t not in seen:
            ordered.append(t)
            seen.add(t)
    return ordered


# --- SessionStart hook (claude only) ----------------------------------------
#
# SessionStart has no "match everything" matcher value -- "prime on every
# session" means one hook GROUP per matcher, each carrying our command
# (confirmed against code.claude.com/docs/en/hooks: startup, resume, clear,
# compact are the four ordinary triggers; "fork" also exists and is
# deliberately left alone here -- a forked session is still primed by
# whichever of the other four brought its parent up).

SESSION_START_MATCHERS = ["startup", "resume", "clear", "compact"]


def hook_command(abs_hook_path=None):
    path = abs_hook_path if abs_hook_path is not None else os.path.join(ENTROPY_HOME, "bin", "adopt")
    return "%s prime" % path


def is_our_hook_entry(entry, hook_cmd_suffix="/bin/adopt prime"):
    """Identify one of OUR hook command strings inside a hooks[] list entry,
    independent of the harness's absolute path (which can move -- see
    lib/roots.sh) -- match on the command ending in "/bin/adopt prime"."""
    if not isinstance(entry, dict):
        return False
    cmd = entry.get("command")
    return isinstance(cmd, str) and cmd.endswith(hook_cmd_suffix)


def load_settings(path):
    """Returns (data, existed, error). error is a human string if the file
    exists but could not be safely parsed/merged -- caller must refuse and
    write nothing."""
    if not os.path.isfile(path):
        return {}, False, None
    try:
        with open(path, encoding="utf-8") as f:
            raw = f.read()
    except OSError as e:
        return None, True, "could not read %s: %s" % (path, e)
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        return None, True, "%s is not valid JSON (%s)" % (path, e)
    if not isinstance(data, dict):
        return None, True, "%s's top level is not a JSON object" % path
    if "hooks" in data and not isinstance(data["hooks"], dict):
        return None, True, "%s's \"hooks\" key is not an object" % path
    if isinstance(data.get("hooks"), dict) and "SessionStart" in data["hooks"] \
            and not isinstance(data["hooks"]["SessionStart"], list):
        return None, True, "%s's hooks.SessionStart is not an array" % path
    return data, True, None


def settings_status(project):
    """missing | stale | current for the claude SessionStart hook, plus the
    parsed settings for reuse. Malformed -> ('error', message, None).
    current requires ALL FOUR matchers present with our exact command; any
    subset (partial install, a stale path in one of the four) is stale."""
    path = settings_json_path(project)
    data, existed, err = load_settings(path)
    if err:
        return "error", err, None
    want_cmd = hook_command()
    if not existed:
        return "missing", None, data
    hooks = data.get("hooks") if isinstance(data, dict) else None
    session_start = hooks.get("SessionStart") if isinstance(hooks, dict) else None
    if not session_start:
        return "missing", None, data
    found = {}
    for group in session_start:
        if not isinstance(group, dict):
            continue
        for entry in group.get("hooks") or []:
            if is_our_hook_entry(entry):
                found[group.get("matcher")] = entry.get("command")
    if not found:
        return "missing", None, data
    if set(SESSION_START_MATCHERS) <= set(found.keys()) and all(
            found[m] == want_cmd for m in SESSION_START_MATCHERS):
        return "current", None, data
    return "stale", None, data


def install_hook(project, dry_run):
    """Merge our SessionStart hooks into .claude/settings.json -- one group
    per matcher in SESSION_START_MATCHERS, since SessionStart has no
    match-everything value. Returns (action, path, err); action is one of
    installed/updated/unchanged/error. NEVER overwrites -- appends into the
    existing SessionStart array (or creates hooks.SessionStart if absent),
    and only ever touches groups/entries it can positively identify as its
    own (see is_our_hook_entry). Refuses outright, writing nothing, on
    anything it cannot parse into the expected shape."""
    path = settings_json_path(project)
    data, existed, err = load_settings(path)
    if err:
        return "error", path, err
    want_cmd = hook_command()
    if not isinstance(data.get("hooks"), dict):
        data["hooks"] = {}
    hooks = data["hooks"]
    if not isinstance(hooks.get("SessionStart"), list):
        hooks["SessionStart"] = []
    session_start = hooks["SessionStart"]

    present_matchers = set()
    changed = False
    for group in session_start:
        if not isinstance(group, dict):
            continue
        for entry in group.get("hooks") or []:
            if is_our_hook_entry(entry):
                present_matchers.add(group.get("matcher"))
                if entry.get("command") != want_cmd:
                    entry["command"] = want_cmd
                    changed = True

    for matcher in SESSION_START_MATCHERS:
        if matcher not in present_matchers:
            session_start.append({
                "matcher": matcher,
                "hooks": [{"type": "command", "command": want_cmd}],
            })
            changed = True

    if not changed:
        return "unchanged", path, None
    if not dry_run:
        _write_settings(path, data)
    return ("installed" if not present_matchers else "updated"), path, None


def remove_hook(project, dry_run):
    path = settings_json_path(project)
    data, existed, err = load_settings(path)
    if err:
        return "error", path, err
    if not existed:
        return "absent", path, None
    hooks = data.get("hooks")
    session_start = hooks.get("SessionStart") if isinstance(hooks, dict) else None
    if not session_start:
        return "absent", path, None
    changed = False
    new_groups = []
    for group in session_start:
        if not isinstance(group, dict):
            new_groups.append(group)
            continue
        remaining = [e for e in (group.get("hooks") or []) if not is_our_hook_entry(e)]
        if len(remaining) != len(group.get("hooks") or []):
            changed = True
        if remaining:
            new_group = dict(group)
            new_group["hooks"] = remaining
            new_groups.append(new_group)
        # else: this group carried ONLY our entry -- drop the whole group
    if not changed:
        return "absent", path, None
    if new_groups:
        hooks["SessionStart"] = new_groups
    else:
        del hooks["SessionStart"]
    if not hooks:
        data.pop("hooks", None)
    if not dry_run:
        if data:
            _write_settings(path, data)
        else:
            os.remove(path)
    return "removed", path, None


def _write_settings(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


# --- status / install / remove per target -----------------------------------

def target_path(name, project):
    return {
        "claude": claude_md_path(project),
        "codex": agents_md_path(project),
        "cursor": cursor_rule_path(project),
    }[name]


def target_profile(name):
    return {"claude": "minimal", "codex": "full", "cursor": "full"}[name]


def status_block_file(name, project):
    path = target_path(name, project)
    profile = target_profile(name)
    if not os.path.isfile(path):
        return "missing", path, None
    with open(path, encoding="utf-8") as f:
        content = f.read()
    m = find_block(content)
    if m is None:
        return "missing", path, None
    found_version, found_profile, found_hash, found_body = m.groups()
    expected_body = render(profile, project)
    expected_hash = body_hash(expected_body)
    if int(found_version) != BLOCK_VERSION or found_profile != profile:
        return "stale", path, {"reason": "version/profile mismatch"}
    if found_hash != body_hash(found_body):
        return "stale", path, {"reason": "hash in marker does not match the body beneath it (hand-edited?)"}
    if found_hash != expected_hash:
        return "stale", path, {"reason": "template or harness path changed since install"}
    return "current", path, None


def status_owned_file(name, project):
    path = target_path(name, project)
    if not os.path.isfile(path):
        return "missing", path, None
    with open(path, encoding="utf-8") as f:
        content = f.read()
    expected = render_cursor(project)
    if content == expected:
        return "current", path, None
    return "stale", path, None


def status(name, project):
    if name in ("claude", "codex"):
        return status_block_file(name, project)
    return status_owned_file(name, project)


def install_target(name, project, dry_run):
    path = target_path(name, project)
    if name in ("claude", "codex"):
        # EVERY REFUSAL COMES BEFORE EVERY WRITE (see bin/init). For claude,
        # that means checking the settings.json hook merge is even possible
        # BEFORE CLAUDE.md is touched -- a target is one atomic unit, not
        # "write what we can and report the rest failed". Confirmed live:
        # without this check, a malformed .claude/settings.json used to
        # still leave CLAUDE.md updated while exiting 2, which is a
        # half-installed target reported as a hard failure.
        if name == "claude":
            _, _, hprecheck_err = load_settings(settings_json_path(project))
            if hprecheck_err:
                return [("error", settings_json_path(project))], hprecheck_err
        profile = target_profile(name)
        new_block, h = block_text(profile, project)
        content = ""
        if os.path.isfile(path):
            with open(path, encoding="utf-8") as f:
                content = f.read()
        new_content, action = insert_or_replace_block(content, new_block, h)
        if not dry_run:
            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
            with open(path, "w", encoding="utf-8") as f:
                f.write(new_content)
        results = [(action, path)]
        if name == "claude":
            haction, hpath, herr = install_hook(project, dry_run)
            if herr:
                # Should not happen -- the precheck above already validated
                # this -- but never silently drop a second failure either.
                results.append(("error", hpath))
                return results, herr
            results.append((haction, hpath))
        return results, None
    else:
        expected = render_cursor(project)
        already = os.path.isfile(path) and open(path, encoding="utf-8").read() == expected
        if not dry_run:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="utf-8") as f:
                f.write(expected)
        return [("unchanged" if already else ("updated" if os.path.isfile(path) else "installed"), path)], None


def remove_target(name, project, dry_run):
    path = target_path(name, project)
    results = []
    if name in ("claude", "codex"):
        if os.path.isfile(path):
            with open(path, encoding="utf-8") as f:
                content = f.read()
            new_content, removed = remove_block(content)
            if removed:
                if not dry_run:
                    if new_content is None:
                        os.remove(path)
                    else:
                        with open(path, "w", encoding="utf-8") as f:
                            f.write(new_content)
                results.append(("removed" if new_content is not None else "removed (file deleted, nothing else was in it)", path))
            else:
                results.append(("absent", path))
        else:
            results.append(("absent", path))
        if name == "claude":
            haction, hpath, herr = remove_hook(project, dry_run)
            if herr:
                results.append(("error", hpath))
                return results, herr
            results.append((haction, hpath))
    else:
        if os.path.isfile(path):
            if not dry_run:
                os.remove(path)
            results.append(("removed", path))
        else:
            results.append(("absent", path))
    return results, None


# --- prime (SessionStart hook body) -----------------------------------------

def cmd_prime():
    project = _entropy_project()
    if not project or not os.path.isfile(os.path.join(project, "entropy.json")):
        print("entropy-machines: not yet configured here -- run %s/bin/init" % ENTROPY_HOME)
        return 0
    tracker = os.path.join(ENTROPY_HOME, "bin", "tracker")

    def run_tracker(args):
        try:
            p = subprocess.run(
                [tracker] + args, cwd=project, capture_output=True, text=True,
                env={**os.environ, "ENTROPY_PROJECT": project}, timeout=15,
            )
        except (OSError, subprocess.SubprocessError):
            return None
        if p.returncode != 0:
            return None
        return p.stdout

    ready_out = run_tracker(["ready"])
    if ready_out is None:
        print("entropy-machines: tracker unavailable (bin/tracker ready failed)")
    else:
        ready = [json.loads(l) for l in ready_out.splitlines() if l.strip()]
        if ready:
            print("entropy-machines: %d issue(s) ready -- `bin/tracker ready`" % len(ready))
            for i in ready[:10]:
                print("  %s  %s" % (i.get("id", "?"), i.get("title") or i.get("summary") or ""))
            if len(ready) > 10:
                print("  ... and %d more" % (len(ready) - 10))
        else:
            print("entropy-machines: 0 issues ready")

    notes_out = run_tracker(["notes"])
    if notes_out is not None:
        state = {}
        for line in notes_out.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            verb = rec.get("verb")
            issue = rec.get("issue")
            if not issue:
                continue
            if verb == "DISPATCH":
                state[issue] = "dispatched"
            elif verb == "HANDOFF":
                state[issue] = "handed_off"
        in_flight = [i for i, s in state.items() if s == "dispatched"]
        if in_flight:
            print("entropy-machines: %d issue(s) in flight (dispatched, not yet handed off): %s"
                  % (len(in_flight), ", ".join(sorted(in_flight))))

    unanswered = _scan_unanswered_docs(project)
    if unanswered:
        total_q = sum(n for _, n in unanswered)
        print("entropy-machines: %d unanswered question(s) across %d doc(s) in %s/:"
              % (total_q, len(unanswered), docs_dir_for(project)))
        for path, n in unanswered:
            print("  %s -- %d unanswered" % (os.path.relpath(path, project), n))
    return 0


def _scan_unanswered_docs(project):
    """Best-effort: dialogue docs in this harness's own convention mark each
    question with <div class="response" data-resp="KEY"> and record answers
    in a <script id="responses-data"> JSON blob (see bin/serve,
    lib/doc-template.html). Returns [(path, unanswered_count), ...] for docs
    with at least one unanswered question. Never raises -- any doc this
    can't parse is silently skipped, since this runs on every session start
    and must not be able to break one."""
    # THE CONFIGURED DOCS DIRECTORY, not "planning/". planning/ is the
    # entropy-machines repo's own gitignored scratch; scanning it here meant
    # this check looked in a directory that does not exist in a consuming
    # project, so it silently reported nothing on every session start -- the
    # one signal that is supposed to tell an agent the owner has questions
    # waiting. bin/init installs the orientation PRD into docs.dir and
    # bin/serve serves it from there; this must agree with both.
    planning_dir = os.path.join(project, docs_dir_for(project))
    if not os.path.isdir(planning_dir):
        return []
    out = []
    resp_re = re.compile(r'class="response"[^>]*data-resp="([^"]+)"')
    data_re = re.compile(r'<script[^>]*id="responses-data"[^>]*>(.*?)</script>', re.DOTALL)
    for fname in sorted(os.listdir(planning_dir)):
        if not fname.endswith(".html"):
            continue
        path = os.path.join(planning_dir, fname)
        try:
            with open(path, encoding="utf-8") as f:
                content = f.read()
            # Strip HTML comments first. lib/doc-template.html documents the
            # contract in its own header comment, and that documentation
            # contains a literal data-resp example -- counting it made every
            # doc built from the template report one phantom question that no
            # reader could ever answer, so a fully-answered doc would keep
            # nagging at every session start. bin/serve had the same bug.
            content = re.sub(r"<!--[\s\S]*?-->", "", content)
            keys = set(resp_re.findall(content))
            if not keys:
                continue
            m = data_re.search(content)
            answered = set()
            if m:
                try:
                    answered = {k for k, v in json.loads(m.group(1)).items() if str(v).strip()}
                except (json.JSONDecodeError, AttributeError):
                    pass
            unanswered_n = len(keys - answered)
            if unanswered_n:
                out.append((path, unanswered_n))
        except OSError:
            continue
    return out


# --- CLI ---------------------------------------------------------------------

def usage(code=2):
    print(__doc__.strip("\n").split("\n\n")[0], file=sys.stderr)
    print("\nusage: bin/adopt [claude|codex|cursor|all] [--dry-run] [--yes]", file=sys.stderr)
    print("       bin/adopt --check [claude|codex|cursor|all]", file=sys.stderr)
    print("       bin/adopt --remove [claude|codex|cursor|all] [--dry-run] [--yes]", file=sys.stderr)
    print("       bin/adopt prime", file=sys.stderr)
    sys.exit(code)


def expand_targets(args):
    if not args:
        return None  # caller picks the mode-appropriate default
    out = []
    for a in args:
        if a == "all":
            out.extend(TARGETS)
        elif a in TARGETS:
            out.append(a)
        else:
            print("adopt: unrecognized target %r (want claude, codex, cursor, or all)" % a, file=sys.stderr)
            sys.exit(2)
    seen = set()
    return [t for t in out if not (t in seen or seen.add(t))]


def confirm(prompt):
    try:
        ans = input(prompt).strip().lower()
    except EOFError:
        return False
    return ans in ("y", "yes")


def print_preview(mode, targets, project):
    print("adopt: would %s, in %s:" % (mode, project))
    for name in targets:
        path = target_path(name, project)
        print("  - %s  (%s)" % (path, name))
        if name == "claude" and mode == "install/update":
            print("    + %s  (SessionStart hook -> `bin/adopt prime`)" % settings_json_path(project))
        if mode == "install/update":
            if name in ("claude", "codex"):
                body = render(target_profile(name), project)
                print("    --- block body (profile:%s) ---" % target_profile(name))
                for line in body.splitlines():
                    print("    | " + line)
                print("    ---")
            else:
                print("    (full file owned by us -- see lib/agent-block.md profile:full)")


def main(argv):
    if argv and argv[0] == "prime":
        if len(argv) > 1:
            usage()
        return cmd_prime()

    mode = "install"
    dry_run = False
    yes = False
    positional = []
    for a in argv:
        if a in ("-h", "--help"):
            usage(0)
        elif a == "--check":
            mode = "check"
        elif a == "--remove":
            mode = "remove"
        elif a == "--dry-run":
            dry_run = True
        elif a == "--yes":
            yes = True
        elif a.startswith("-"):
            print("adopt: unrecognized flag %r" % a, file=sys.stderr)
            usage()
        else:
            positional.append(a)

    project = require_project()
    named = expand_targets(positional)

    if mode == "check":
        targets = named if named is not None else list(TARGETS)
        all_current = True
        for name in targets:
            st, path, detail = status(name, project)
            print("adopt: %-7s %-8s %s" % (name, st, path))
            if detail and detail.get("reason"):
                print("        %s" % detail["reason"])
            if name == "claude":
                hst, herr, _ = settings_status(project)
                print("adopt: %-7s %-8s %s" % ("claude-hook", hst, settings_json_path(project)))
                if hst == "error":
                    print("        %s" % herr)
                if hst != "current":
                    all_current = False
            if st != "current":
                all_current = False
        return 0 if all_current else 1

    if mode == "remove":
        targets = named if named is not None else list(TARGETS)
        print_preview("remove", targets, project)
        if not dry_run and not yes:
            if not confirm("Proceed? [y/N] "):
                print("adopt: declined -- nothing removed.")
                return 1
        if dry_run:
            print("adopt: --dry-run -- nothing removed.")
            return 0
        ok = True
        for name in targets:
            results, err = remove_target(name, project, dry_run)
            for action, path in results:
                print("adopt: %-7s %-8s %s" % (name, action, path))
            if err:
                print("adopt: %-7s error    %s" % (name, err), file=sys.stderr)
                ok = False
        return 0 if ok else 2

    # install
    targets = named if named is not None else detect_targets(project)
    print_preview("install/update", targets, project)
    if dry_run:
        print("adopt: --dry-run -- nothing written.")
        return 0
    if not yes:
        if not confirm("Proceed? [y/N] "):
            print("adopt: declined -- nothing written.")
            return 1
    ok = True
    for name in targets:
        results, err = install_target(name, project, dry_run)
        for action, path in results:
            print("adopt: %-7s %-8s %s" % (name, action, path))
        if err:
            print("adopt: %-7s error    %s" % (name, err), file=sys.stderr)
            ok = False
    return 0 if ok else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
