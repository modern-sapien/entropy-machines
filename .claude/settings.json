{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bin/no-fork-gate"
          },
          {
            "type": "command",
            "command": "bin/dispatch-gate"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/dispatch-gate-writes"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/dispatch-gate-writes"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/mcp-gate"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
