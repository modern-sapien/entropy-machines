<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template. `scripts/drain install` substitutes __RUNNER__ / __STATE__ and
  writes the result to ~/Library/LaunchAgents/com.janus.drain.plist.

  HOURLY, not pinned to a boundary. There is no API for the rate-limit window
  (checked 2026-08-09), so predicting the reset means guessing, and a job
  pinned to 03:00 sits idle through a window that opened at 06:00. An hourly
  probe that exits in milliseconds when disarmed, dirty, or walled costs
  effectively nothing and catches every window within an hour of it opening.

  The job is INERT until `scripts/drain on` — StartCalendarInterval fires,
  drain-run.sh reads the armed flag, and exits 2. Removing the switch from the
  plist is deliberate: arming must not require a launchctl reload.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.janus.drain</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__RUNNER__</string>
  </array>

  <!-- Top of every hour. Minute 7 rather than 0: every scheduled job on the
       planet fires at :00, and nothing here needs the boundary. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>7</integer>
  </dict>

  <!-- launchd coalesces missed fires while asleep into ONE catch-up run, which
       is what we want: waking to six queued fires would run six sessions. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__STATE__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE__/launchd.err.log</string>

  <!-- A login shell's PATH is not inherited by launchd. claude, node, gh and
       python3 all live in places launchd does not know about by default. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
