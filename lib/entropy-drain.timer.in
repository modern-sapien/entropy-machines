# Template. `bin/drain install` substitutes __RUNNER__ / __STATE__ (neither
# is actually used below today — kept for symmetry with entropy-drain.service.in
# and because a future revision of the schedule may want the state dir, e.g.
# to disable the timer when a marker file is present) and writes the result
# to ~/.config/systemd/user/<unattended.label>.timer.
#
# HOURLY, not pinned to a boundary — see entropy-drain.service.in and the
# launchd plist (lib/entropy-drain.plist.in) for why: there is generally no
# API for an agent CLI's own rate-limit window, so an hourly probe that costs
# nothing when disarmed, dirty, or walled catches every window within an
# hour of it opening instead of guessing at a fixed reset time.
[Unit]
Description=Hourly schedule for the unattended work drain (see bin/drain)

[Timer]
# Minute 7 rather than 0, matching the launchd plist: every scheduled job on
# the planet fires at the top of the hour, and nothing here needs the
# boundary.
OnCalendar=*-*-* *:07:00
# A missed fire (machine asleep/suspended through :07) runs ONCE on the next
# wake rather than being silently dropped — the systemd equivalent of
# launchd coalescing missed StartCalendarInterval fires into one catch-up
# run. Waking to a queue of once-per-missed-hour fires would run one session
# per hour missed, which is the opposite of what this is for.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
