#!/usr/bin/env bash
# Repo post-commit hook — VERSION-CONTROLLED, like its pre-commit and
# commit-msg siblings, and installed by the same lib/install-hooks.sh.
# install-hooks.sh iterates every file in hooks/, so this one is picked up
# the moment it lands; the installer needs no change to find it.
#
# After every commit, auto-close issues whose id appears in the commit
# message (e.g. "feat(i-resizable-panels): ...").
#
# FAIL-OPEN. The commit is already recorded; a hook failure must not
# look like a commit failure. Deliberately no `set -e`.

set -u

trap 'exit 0' EXIT

# The test harness (tests/run) exports ENTROPY_SRC. Skip in test sandboxes.
[ -z "${ENTROPY_SRC:-}" ] || exit 0

. "$(dirname "$0")/../lib/roots.sh"

: "${ENTROPY_MACHINES_HOME:=$(entropy_machines_home "$0")}"
export ENTROPY_MACHINES_HOME

ENTROPY_MACHINES_ROOT=$(entropy_machines_root 2>/dev/null) || exit 0
export ENTROPY_MACHINES_ROOT

# --- auto-close issues from commit message ------------------------------------
# A commit message like "feat(i-resizable-panels): ..." means that issue landed.
msg=$(git log -1 --format=%s HEAD 2>/dev/null) || true
issue_id=$(printf '%s' "$msg" | sed -n 's/^[a-z]*(\(i-[^)]*\)).*/\1/p')
if [ -n "$issue_id" ] && [ -x "$ENTROPY_MACHINES_HOME/bin/tracker" ]; then
  ( cd "$ENTROPY_MACHINES_ROOT" && "$ENTROPY_MACHINES_HOME/bin/tracker" set "$issue_id" status=done ) 2>/dev/null || true
  echo "post-commit: marked $issue_id done" >&2
fi

exit 0
